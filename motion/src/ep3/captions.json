 },
 {
  "s": 190.867,
  "e": 193.867,
  "text": "따라서 중요 동사와 역접속사가 있는지를 먼저 체크하고"
 },
 {
  "s": 193.867,
  "e": 196.167,
  "text": "있으면 그 부분부터 읽으면 답이 나올 겁니다"
 },
 {
  "s": 196.167,
  "e": 198.567,
  "text": "하지만 폭우가 길을 미끄럽게 하고 위험하게 하고"
 },
 {
  "s": 198.567,
  "e": 200.467,
  "text": "그래서 결과적으로 레이스를 취소 하겠다"
 },
 {
  "s": 200.467,
  "e": 201.267,
  "text": "바로 1번이죠"
 },
 {
  "s": 201.267,
  "e": 203.067,
  "text": "19번 심경"
 },
 {
  "s": 203.067,
  "e": 204.267,
  "text": "맨 끝 두 문장을 먼저 읽고"
 },
 {
  "s": 204.267,
  "e": 205.467,
