[
 {
  "s": 0.0,
  "e": 1.0,
  "text": "6모가 코앞인데"
 },
 {
  "s": 1.0,
  "e": 2.5,
  "text": "아직 모의고사 푸는 순서도 모르고"
 },
 {
  "s": 2.5,
  "e": 3.4,
  "text": "어떤 전략으로 가야 하는지"
 },
 {
  "s": 3.4,
  "e": 4.7,
  "text": "전혀 모르는 친구들을 위해서"
 },
 {
  "s": 4.7,
  "e": 6.5,
  "text": "누보쌤이 모의고사 점수 확 끌어올리는"
 },
 {
  "s": 6.45,
  "e": 7.5,
  "text": "상승 전략 준비했어요"
 },
 {
  "s": 7.5,
  "e": 8.7,
  "text": "미리 연습해두지 않으면"
 },
 {
  "s": 8.7,
  "e": 10.8,
  "text": "당일날 원래 풀던 버릇으로 돌아갈 수 있으니"
 },
 {
  "s": 10.8,
  "e": 12.3,
  "text": "지금 제가 알려드린 이 전략을"
 },
 {
  "s": 12.3,
  "e": 14.2,
  "text": "일주일 이상 꼭 연습해 주시기 바랍니다"
 },
 {
  "s": 14.2,
  "e": 16.1,
  "text": "쌤이 목표 등급별로 올바른"
 },
 {
  "s": 16.05,
  "e": 17.6,
  "text": "풀이 전략, 풀이 순서, 풀이 꿀팁"
 },
 {
  "s": 17.6,
  "e": 18.5,
  "text": "전부 알려드릴게요"
 },
 {
  "s": 21.467,
  "e": 22.567,
  "text": "듣기부터 설명을 드리면"
 },
 {
  "s": 22.567,
  "e": 23.967,
  "text": "3등급이 목표인 친구들은"
 },
 {
  "s": 23.867,
  "e": 25.867,
  "text": "듣기를 무조건 다 맞는 데 집중하셔야 합니다"
 },
 {
  "s": 25.867,
  "e": 26.767,
  "text": "따라서 듣기 들으면서"
 },
 {
  "s": 26.767,
  "e": 28.967,
  "text": "뒤에 독해 문제 안 건드리시는 걸 추천합니다"
 },
 {
  "s": 28.967,
  "e": 30.367,
  "text": "어차피 3등급이 목표면"
 },
 {
  "s": 30.367,
  "e": 31.667,
  "text": "푸는 문제가 한정되어 있어서"
 },
 {
  "s": 31.667,
  "e": 33.267,
  "text": "시간 별로 부족하지 않습니다"
 },
 {
  "s": 33.267,
  "e": 34.067,
  "text": "잊지 마셔야 하는 게 여러분"
 },
 {
  "s": 34.067,
  "e": 36.367,
  "text": "배점은 똑같이 2점 이거나 3점입니다"
 },
 {
  "s": 36.367,
  "e": 38.067,
  "text": "듣기에서 점수 날리시면 안 됩니다"
 },
 {
  "s": 38.067,
  "e": 40.267,
  "text": "그리고 1에서 2등급 목표로 하는 친구들은"
 },
 {
  "s": 40.267,
  "e": 41.267,
  "text": "보통 시간 부족이"
 },
 {
  "s": 41.267,
  "e": 43.267,
  "text": "점수를 깎아먹는 원인인 경우가 많기 때문에"
 },
 {
  "s": 43.267,
  "e": 44.567,
  "text": "가급적 듣기 들으면서"
 },
 {
  "s": 44.567,
  "e": 46.267,
  "text": "쉬운 유형 클리어 해주시는 게 좋습니다"
 },
 {
  "s": 46.267,
  "e": 47.967,
  "text": "18번 목적 19번 심경"
 },
 {
  "s": 47.967,
  "e": 49.867,
  "text": "25번 ~ 28번 도표 일치 불일치"
 },
 {
  "s": 49.867,
  "e": 52.167,
  "text": "총 6문제 건드리면 1차 성공이고"
 },
 {
  "s": 52.167,
  "e": 53.067,
  "text": "나는 더 잘한다"
 },
 {
  "s": 53.067,
  "e": 54.367,
  "text": "시간이 더 남는다 라고 한다면"
 },
 {
  "s": 54.367,
  "e": 57.367,
  "text": "20번 주장 43~45번 스토리 장문까지"
 },
 {
  "s": 57.367,
  "e": 58.567,
  "text": "건드리시는 거 추천합니다"
 },
 {
  "s": 58.967,
  "e": 59.767,
  "text": "이제 여러분이 어려워하시는"
 },
 {
  "s": 59.767,
  "e": 60.767,
  "text": "듣기 유형 꿀팁 알려드리겠습니다"
 },
 {
  "s": 60.767,
  "e": 62.367,
  "text": "6번 금액 문제, 많이 틀리는 유형인데요"
 },
 {
  "s": 62.367,
  "e": 63.767,
  "text": "팁은 필기가 생명이라는 겁니다"
 },
 {
  "s": 63.767,
  "e": 64.967,
  "text": "처음에 품목을 고르고"
 },
 {
  "s": 64.967,
  "e": 65.767,
  "text": "그 다음 추가 품목"
 },
 {
  "s": 65.767,
  "e": 66.767,
  "text": "마지막에 할인이나"
 },
 {
  "s": 66.767,
  "e": 68.667,
  "text": "배송 관련 얘기를 한다는 것을 예상해 두시고요"
 },
 {
  "s": 68.667,
  "e": 70.767,
  "text": "선을 그어놓고 들리는 모든 품목과"
 },
 {
  "s": 70.767,
  "e": 72.567,
  "text": "숫자를 적고, 안 산다고 하는 것"
 },
 {
  "s": 72.567,
  "e": 74.467,
  "text": "또는 선택하지 않은 걸 그때그때 지우면 됩니다"
 },
 {
  "s": 74.467,
  "e": 76.267,
  "text": "그리고 추가로 세 번째 할인이랑 배송 나올 때"
 },
 {
  "s": 76.267,
  "e": 77.567,
  "text": "낚시 표현 조심하셔야 되는데"
 },
 {
  "s": 77.567,
  "e": 79.367,
  "text": "10% 인지 10$ 인지"
 },
 {
  "s": 79.367,
  "e": 81.667,
  "text": "한 품목만인지 total 전체 할인인지"
 },
 {
  "s": 81.667,
  "e": 82.467,
  "text": "잘 들으셔야 됩니다"
 },
 {
  "s": 82.467,
  "e": 84.667,
  "text": "그리고 10% 할인 계산할 때 팁인데요"
 },
 {
  "s": 84.667,
  "e": 86.867,
  "text": "전체 금액에서 숫자 0만 떼면"
 },
 {
  "s": 86.867,
  "e": 88.167,
  "text": "그게 10% 금액이 되니까"
 },
 {
  "s": 88.167,
  "e": 88.967,
  "text": "그걸 빼면 됩니다"
 },
 {
  "s": 88.967,
  "e": 91.067,
  "text": "즉 200$에 10% 할인이면"
 },
 {
  "s": 91.067,
  "e": 93.067,
  "text": "0 떼고 20$ 깎아 주겠다는 겁니다"
 },
 {
  "s": 93.067,
  "e": 94.767,
  "text": "그러니까 200-20=180"
 },
 {
  "s": 94.767,
  "e": 95.667,
  "text": "이렇게 고르시면 되겠죠"
 },
 {
  "s": 95.667,
  "e": 97.667,
  "text": "가장 단순하게 생각하는 방법입니다"
 },
 {
  "s": 97.667,
  "e": 100.267,
  "text": "그리고 11~15번 이 파트 약점자는"
 },
 {
  "s": 100.267,
  "e": 102.767,
  "text": "선지 해석이 느려서 틀리는 경우가 꽤 많습니다"
 },
 {
  "s": 102.767,
  "e": 104.167,
  "text": "듣기 끝나고 선지 읽고 있는데"
 },
 {
  "s": 104.167,
  "e": 105.567,
  "text": "다음 문제가 나오기 시작하는 거죠"
 },
 {
  "s": 105.567,
  "e": 107.267,
  "text": "따라서 다른 문제 정답 고르고"
 },
 {
  "s": 107.267,
  "e": 108.867,
  "text": "남는 시간에 이 선지 해석하고"
 },
 {
  "s": 108.867,
  "e": 111.267,
  "text": "앞에 내용 뭐 나올지 예측해 주면 좋습니다"
 },
 {
  "s": 111.267,
  "e": 113.467,
  "text": "11, 12번은 미리 남는 시간들에"
 },
 {
  "s": 113.467,
  "e": 114.767,
  "text": "예측 내용 적어두고"
 },
 {
  "s": 114.767,
  "e": 116.467,
  "text": "듣기 나올 때는 완전히 집중해서"
 },
 {
  "s": 116.467,
  "e": 117.267,
  "text": "잘 들으셔야 되고요"
 },
 {
  "s": 117.267,
  "e": 118.967,
  "text": "듣기 들으면서 여백에 가볍게"
 },
 {
  "s": 118.967,
  "e": 120.067,
  "text": "내용 적어두는 것도 좋습니다"
 },
 {
  "s": 121.667,
  "e": 123.767,
  "text": "이제 목표 등급별 풀이 순서 알려드릴게요"
 },
 {
  "s": 123.867,
  "e": 127.467,
  "text": "3등급 목표인 경우 1단계 18~28번까지 쭉 풉니다"
 },
 {
  "s": 127.467,
  "e": 129.367,
  "text": "즉 18번부터 20번까지 푸시고"
 },
 {
  "s": 129.367,
  "e": 131.767,
  "text": "21번은 제외하고 22~24번 푸시고"
 },
 {
  "s": 131.767,
  "e": 133.667,
  "text": "25~28번 쭉 푸시고요"
 },
 {
  "s": 133.667,
  "e": 136.667,
  "text": "그리고 맨 뒤로 넘어와서 2단계 43~45번 푸시고"
 },
 {
  "s": 136.667,
  "e": 139.167,
  "text": "42번은 어렵지만 41번은 제목이라"
 },
 {
  "s": 139.167,
  "e": 142.267,
  "text": "할 만하니까 41번까지 시도해 주시면 좋습니다"
 },
 {
  "s": 142.267,
  "e": 145.667,
  "text": "그리고 마지막으로 3단계 35번, 40번 풀어 주시면 됩니다"
 },
 {
  "s": 145.667,
  "e": 147.867,
  "text": "제가 지금 보여드린 순서대로 푸셔야 하고"
 },
 {
  "s": 147.867,
  "e": 149.767,
  "text": "이 유형에 엄청 집중하셔야 합니다"
 },
 {
  "s": 149.767,
  "e": 151.267,
  "text": "남은 문제는 시도는 해보되"
 },
 {
  "s": 151.267,
  "e": 152.467,
  "text": "어려우면 그냥 찍을 건데"
 },
 {
  "s": 152.467,
  "e": 153.867,
  "text": "찍기 팁은 마지막에 알려드릴게요"
 },
 {
  "s": 153.867,
  "e": 157.267,
  "text": "1, 2등급 목표일 때 18, 19번은 듣기 들으면서 클리어돼 있겠죠"
 },
 {
  "s": 157.267,
  "e": 161.367,
  "text": "1단계로 20~30번까지 빠지는 문제 없이 쭉 풉니다"
 },
 {
  "s": 161.367,
  "e": 162.467,
  "text": "그리고 맨 뒷장으로 가서"
 },
 {
  "s": 162.467,
