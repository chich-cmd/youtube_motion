[{"start": 0.0, "end": 5.74, "text": " 앞으로 이 방법으로 연습하시면 장담컨대 한 달이면 독해됩니다.", "words": [{"s": 0.0, "e": 0.44, "w": " 앞으로"}, {"s": 0.44, "e": 0.9, "w": " 이"}, {"s": 0.9, "e": 1.72, "w": " 방법으로"}, {"s": 1.72, "e": 3.0, "w": " 연습하시면"}, {"s": 3.0, "e": 4.04, "w": " 장담컨대"}, {"s": 4.04, "e": 4.42, "w": " 한"}, {"s": 4.42, "e": 4.86, "w": " 달이면"}, {"s": 4.86, "e": 5.74, "w": " 독해됩니다."}]}, {"start": 6.1, "end": 10.38, "text": " 안녕하세요. 고3 8등급 학생을 수능 때 1등급 집계한 누보 영어쌤입니다.", "words": [{"s": 6.1, "e": 6.34, "w": " 안녕하세요."}, {"s": 6.64, "e": 6.9, "w": " 고3"}, {"s": 6.9, "e": 7.52, "w": " 8등급"}, {"s": 7.52, "e": 7.94, "w": " 학생을"}, {"s": 7.94, "e": 8.2, "w": " 수능"}, {"s": 8.2, "e": 8.34, "w": " 때"}, {"s": 8.34, "e": 8.86, "w": " 1등급"}, {"s": 8.86, "e": 9.3, "w": " 집계한"}, {"s": 9.3, "e": 9.7, "w": " 누보"}, {"s": 9.7, "e": 10.38, "w": " 영어쌤입니다."}]}, {"start": 10.54, "end": 16.06, "text": " 오늘은 영어 문장을 읽었는데도 머릿속에 아무것도 안 남는 문제를 완벽하게 잡아드릴게요.", "words": [{"s": 10.54, "e": 10.92, "w": " 오늘은"}, {"s": 10.92, "e": 11.44, "w": " 영어"}, {"s": 11.44, "e": 11.68, "w": " 문장을"}, {"s": 11.68, "e": 12.32, "w": " 읽었는데도"}, {"s": 12.32, "e": 13.0, "w": " 머릿속에"}, {"s": 13.0, "e": 13.44, "w": " 아무것도"}, {"s": 13.44, "e": 13.78, "w": " 안"}, {"s": 13.78, "e": 14.06, "w": " 남는"}, {"s": 14.06, "e": 14.42, "w": " 문제를"}, {"s": 14.42, "e": 15.32, "w": " 완벽하게"}, {"s": 15.32, "e": 16.06, "w": " 잡아드릴게요."}]}, {"start": 16.24, "end": 18.08, "text": " 자신하는데 국어에도 도움되실 거예요.", "words": [{"s": 16.24, "e": 16.86, "w": " 자신하는데"}, {"s": 16.86, "e": 17.42, "w": " 국어에도"}, {"s": 17.42, "e": 17.88, "w": " 도움되실"}, {"s": 17.88, "e": 18.08, "w": " 거예요."}]}, {"start": 18.3, "end": 23.44, "text": " 해석을 했으면 머리에 남는 게 있어야 되는데 왜 생각이 안 나고 대충 단어만 기억나는 걸까요?", "words": [{"s": 18.3, "e": 18.74, "w": " 해석을"}, {"s": 18.74, "e": 18.98, "w": " 했으면"}, {"s": 18.98, "e": 19.44, "w": " 머리에"}, {"s": 19.44, "e": 19.76, "w": " 남는"}, {"s": 19.76, "e": 19.84, "w": " 게"}, {"s": 19.84, "e": 20.02, "w": " 있어야"}, {"s": 20.02, "e": 20.22, "w": " 되는데"}, {"s": 20.22, "e": 20.62, "w": " 왜"}, {"s": 20.62, "e": 21.16, "w": " 생각이"}, {"s": 21.16, "e": 21.48, "w": " 안"}, {"s": 21.48, "e": 21.78, "w": " 나고"}, {"s": 21.78, "e": 22.28, "w": " 대충"}, {"s": 22.28, "e": 22.84, "w": " 단어만"}, {"s": 22.84, "e": 23.2, "w": " 기억나는"}, {"s": 23.2, "e": 23.44, "w": " 걸까요?"}]}, {"start": 23.66, "end": 26.54, "text": " 바로 직관력 없이 글을 읽었기 때문입니다.", "words": [{"s": 23.66, "e": 23.92, "w": " 바로"}, {"s": 23.92, "e": 24.82, "w": " 직관력"}, {"s": 24.82, "e": 25.3, "w": " 없이"}, {"s": 25.3, "e": 25.8, "w": " 글을"}, {"s": 25.8, "e": 26.1, "w": " 읽었기"}, {"s": 26.1, "e": 26.54, "w": " 때문입니다."}]}, {"start": 26.54, "end": 28.78, "text": " 글을 읽을 때 우리가 해야 하는 건", "words": [{"s": 26.54, "e": 27.08, "w": " 글을"}, {"s": 27.08, "e": 27.3, "w": " 읽을"}, {"s": 27.3, "e": 27.42, "w": " 때"}, {"s": 27.42, "e": 28.04, "w": " 우리가"}, {"s": 28.04, "e": 28.4, "w": " 해야"}, {"s": 28.4, "e": 28.56, "w": " 하는"}, {"s": 28.56, "e": 28.78, "w": " 건"}]}, {"start": 28.78, "end": 30.92, "text": " 해설지처럼 예쁜 해석이 아니라", "words": [{"s": 28.78, "e": 29.56, "w": " 해설지처럼"}, {"s": 29.56, "e": 30.12, "w": " 예쁜"}, {"s": 30.12, "e": 30.46, "w": " 해석이"}, {"s": 30.46, "e": 30.92, "w": " 아니라"}]}, {"start": 30.92, "end": 32.94, "text": " 아 무슨 내용이라고 하고", "words": [{"s": 30.92, "e": 31.36, "w": " 아"}, {"s": 31.36, "e": 31.88, "w": " 무슨"}, {"s": 31.88, "e": 32.28, "w": " 내용이라고"}, {"s": 32.28, "e": 32.94, "w": " 하고"}]}, {"start": 32.94, "end": 36.56, "text": " 내가 읽는 족족 핵심적인 게 뭔지 떠올리는 겁니다.", "words": [{"s": 32.94, "e": 33.54, "w": " 내가"}, {"s": 33.54, "e": 34.2, "w": " 읽는"}, {"s": 34.2, "e": 34.54, "w": " 족족"}, {"s": 34.54, "e": 35.22, "w": " 핵심적인"}, {"s": 35.22, "e": 35.38, "w": " 게"}, {"s": 35.38, "e": 35.76, "w": " 뭔지"}, {"s": 35.76, "e": 36.3, "w": " 떠올리는"}, {"s": 36.3, "e": 36.56, "w": " 겁니다."}]}, {"start": 36.74, "end": 38.44, "text": " 저는 이걸 직관력이라고 하는데", "words": [{"s": 36.74, "e": 37.02, "w": " 저는"}, {"s": 37.02, "e": 37.5, "w": " 이걸"}, {"s": 37.5, "e": 38.18, "w": " 직관력이라고"}, {"s": 38.18, "e": 38.44, "w": " 하는데"}]}, {"start": 38.44, "end": 42.08, "text": " 아 뭐란 거구나 하는 생각이 퍼뜩 떠올라야 하기 때문입니다.", "words": [{"s": 38.44, "e": 38.88, "w": " 아"}, {"s": 38.88, "e": 39.36, "w": " 뭐란"}, {"s": 39.36, "e": 39.64, "w": " 거구나"}, {"s": 39.64, "e": 40.04, "w": " 하는"}, {"s": 40.04, "e": 40.42, "w": " 생각이"}, {"s": 40.42, "e": 41.14, "w": " 퍼뜩"}, {"s": 41.14, "e": 41.56, "w": " 떠올라야"}, {"s": 41.56, "e": 41.66, "w": " 하기"}, {"s": 41.66, "e": 42.08, "w": " 때문입니다."}]}, {"start": 42.26, "end": 44.68, "text": " 이 연습이 되어 있지 않으면 그냥 해석만 잘하게 되고", "words": [{"s": 42.26, "e": 42.38, "w": " 이"}, {"s": 42.38, "e": 42.7, "w": " 연습이"}, {"s": 42.7, "e": 42.84, "w": " 되어"}, {"s": 42.84, "e": 43.0, "w": " 있지"}, {"s": 43.0, "e": 43.28, "w": " 않으면"}, {"s": 43.28, "e": 43.7, "w": " 그냥"}, {"s": 43.7, "e": 44.22, "w": " 해석만"}, {"s": 44.22, "e": 44.44, "w": " 잘하게"}, {"s": 44.44, "e": 44.68, "w": " 되고"}]}, {"start": 44.68, "end": 46.62, "text": " 그럼 3등급에서 끝입니다.", "words": [{"s": 44.68, "e": 45.08, "w": " 그럼"}, {"s": 45.08, "e": 46.0, "w": " 3등급에서"}, {"s": 46.0, "e": 46.62, "w": " 끝입니다."}]}, {"start": 46.82, "end": 50.96, "text": " 국어 읽고 이해 안 되는 친구들도 보통 동일한 문제를 겪고 있습니다.", "words": [{"s": 46.82, "e": 47.12, "w": " 국어"}, {"s": 47.12, "e": 47.48, "w": " 읽고"}, {"s": 47.48, "e": 47.86, "w": " 이해"}, {"s": 47.86, "e": 48.02, "w": " 안"}, {"s": 48.02, "e": 48.22, "w": " 되는"}, {"s": 48.22, "e": 48.68, "w": " 친구들도"}, {"s": 48.68, "e": 49.28, "w": " 보통"}, {"s": 49.28, "e": 49.92, "w": " 동일한"}, {"s": 49.92, "e": 50.24, "w": " 문제를"}, {"s": 50.24, "e": 50.7, "w": " 겪고"}, {"s": 50.7, "e": 50.96, "w": " 있습니다."}]}, {"start": 51.22, "end": 53.22, "text": " 어찌 보면 속발음이랑 비슷한 건데", "words": [{"s": 51.22, "e": 51.4, "w": " 어찌"}, {"s": 51.4, "e": 51.6, "w": " 보면"}, {"s": 51.6, "e": 52.52, "w": " 속발음이랑"}, {"s": 52.52, "e": 53.02, "w": " 비슷한"}, {"s": 53.02, "e": 53.22, "w": " 건데"}]}, {"start": 53.22, "end": 55.56, "text": " 속발음 자체가 중요한 게 아니라", "words": [{"s": 53.22, "e": 54.02, "w": " 속발음"}, {"s": 54.02, "e": 54.62, "w": " 자체가"}, {"s": 54.62, "e": 54.96, "w": " 중요한"}, {"s": 54.96, "e": 55.12, "w": " 게"}, {"s": 55.12, "e": 55.56, "w": " 아니라"}]}, {"start": 55.56, "end": 58.7, "text": " 읽었으면 이해든 기억이든 뭐든 남아야 하는데", "words": [{"s": 55.56, "e": 56.22, "w": " 읽었으면"}, {"s": 56.22, "e": 56.68, "w": " 이해든"}, {"s": 56.68, "e": 57.3, "w": " 기억이든"}, {"s": 57.3, "e": 57.8, "w": " 뭐든"}, {"s": 57.8, "e": 58.42, "w": " 남아야"}, {"s": 58.42, "e": 58.7, "w": " 하는데"}]}, {"start": 58.7, "end": 60.9, "text": " 아무것도 남지 않는 게 문제인 거죠.", "words": [{"s": 58.7, "e": 59.4, "w": " 아무것도"}, {"s": 59.4, "e": 59.8, "w": " 남지"}, {"s": 59.8, "e": 59.94, "w": " 않는"}, {"s": 59.94, "e": 60.1, "w": " 게"}, {"s": 60.1, "e": 60.78, "w": " 문제인"}, {"s": 60.78, "e": 60.9, "w": " 거죠."}]}, {"start": 61.12, "end": 62.56, "text": " 그러면 어떻게 연습해야 할까요?", "words": [{"s": 61.12, "e": 61.34, "w": " 그러면"}, {"s": 61.34, "e": 61.88, "w": " 어떻게"}, {"s": 61.88, "e": 62.3, "w": " 연습해야"}, {"s": 62.3, "e": 62.56, "w": " 할까요?"}]}, {"start": 62.94, "end": 66.9, "text": " 당연히 읽는 족족 핵심을 기억하는 연습을 해야겠죠.", "words": [{"s": 62.94, "e": 63.5, "w": " 당연히"}, {"s": 63.5, "e": 64.04, "w": " 읽는"}, {"s": 64.04, "e": 64.52, "w": " 족족"}, {"s": 64.52, "e": 65.26, "w": " 핵심을"}, {"s": 65.26, "e": 65.98, "w": " 기억하는"}, {"s": 65.98, "e": 66.42, "w": " 연습을"}, {"s": 66.42, "e": 66.9, "w": " 해야겠죠."}]}, {"start": 67.02, "end": 70.32, "text": " 따라만 하면 되도록 쌤이 단계를 나눠서 알려드릴게요.", "words": [{"s": 67.02, "e": 67.42, "w": " 따라만"}, {"s": 67.42, "e": 67.62, "w": " 하면"}, {"s": 67.62, "e": 67.96, "w": " 되도록"}, {"s": 67.96, "e": 68.52, "w": " 쌤이"}, {"s": 68.52, "e": 69.2, "w": " 단계를"}, {"s": 69.2, "e": 69.62, "w": " 나눠서"}, {"s": 69.62, "e": 70.32, "w": " 알려드릴게요."}]}, {"start": 70.54, "end": 74.86, "text": " 1단계. 한 줄을 다 읽고 고개를 들어 뭔 내용인지 생각하는 거예요.", "words": [{"s": 70.54, "e": 70.96, "w": " 1단계."}, {"s": 71.08, "e": 71.34, "w": " 한"}, {"s": 71.34, "e": 71.78, "w": " 줄을"}, {"s": 71.78, "e": 72.0, "w": " 다"}, {"s": 72.0, "e": 72.46, "w": " 읽고"}, {"s": 72.46, "e": 72.92, "w": " 고개를"}, {"s": 72.92, "e": 73.14, "w": " 들어"}, {"s": 73.14, "e": 73.56, "w": " 뭔"}, {"s": 73.56, "e": 74.02, "w": " 내용인지"}, {"s": 74.02, "e": 74.7, "w": " 생각하는"}, {"s": 74.7, "e": 74.86, "w": " 거예요."}]}, {"start": 75.04, "end": 77.52, "text": " 그리고 옆에다가 대충 요약해서 적어보는 거죠.", "words": [{"s": 75.04, "e": 75.28, "w": " 그리고"}, {"s": 75.28, "e": 75.88, "w": " 옆에다가"}, {"s": 75.88, "e": 76.36, "w": " 대충"}, {"s": 76.36, "e": 76.78, "w": " 요약해서"}, {"s": 76.78, "e": 77.34, "w": " 적어보는"}, {"s": 77.34, "e": 77.52, "w": " 거죠."}]}, {"start": 77.72, "end": 81.48, "text": " 예를 들어 이 문장을 읽고 고개를 들어 생각하는 겁니다.", "words": [{"s": 77.72, "e": 78.0, "w": " 예를"}, {"s": 78.0, "e": 78.24, "w": " 들어"}, {"s": 78.24, "e": 78.68, "w": " 이"}, {"s": 78.68, "e": 79.06, "w": " 문장을"}, {"s": 79.06, "e": 79.54, "w": " 읽고"}, {"s": 79.54, "e": 80.26, "w": " 고개를"}, {"s": 80.26, "e": 80.52, "w": " 들어"}, {"s": 80.52, "e": 81.26, "w": " 생각하는"}, {"s": 81.26, "e": 81.48, "w": " 겁니다."}]}, {"start": 81.48, "end": 85.96, "text": " 아 휘트먼 전에 이미 시인들이 명성을 원했구나.", "words": [{"s": 81.48, "e": 82.0, "w": " 아"}, {"s": 82.0, "e": 82.82, "w": " 휘트먼"}, {"s": 82.82, "e": 83.2, "w": " 전에"}, {"s": 83.2, "e": 83.84, "w": " 이미"}, {"s": 83.84, "e": 84.6, "w": " 시인들이"}, {"s": 84.6, "e": 85.44, "w": " 명성을"}, {"s": 85.44, "e": 85.96, "w": " 원했구나."}]}, {"start": 86.3, "end": 88.22, "text": " 그리고 옆에 이렇게 써볼 수 있겠죠?", "words": [{"s": 86.3, "e": 86.78, "w": " 그리고"}, {"s": 86.78, "e": 87.38, "w": " 옆에"}, {"s": 87.38, "e": 87.6, "w": " 이렇게"}, {"s": 87.6, "e": 87.84, "w": " 써볼"}, {"s": 87.84, "e": 87.94, "w": " 수"}, {"s": 87.94, "e": 88.22, "w": " 있겠죠?"}]}, {"start": 88.5, "end": 93.56, "text": " 시인들 명성 원함 해석 다 써놓고 복사하듯이 필기하는 게 아니라", "words": [{"s": 88.5, "e": 89.14, "w": " 시인들"}, {"s": 89.14, "e": 89.76, "w": " 명성"}, {"s": 89.76, "e": 90.34, "w": " 원함"}, {"s": 90.34, "e": 90.8, "w": " 해석"}, {"s": 90.8, "e": 91.02, "w": " 다"}, {"s": 91.02, "e": 91.48, "w": " 써놓고"}, {"s": 91.48, "e": 92.66, "w": " 복사하듯이"}, {"s": 92.66, "e": 93.2, "w": " 필기하는"}, {"s": 93.2, "e": 93.3, "w": " 게"}, {"s": 93.3, "e": 93.56, "w": " 아니라"}]}, {"start": 93.56, "end": 97.54, "text": " 읽고 내가 떠올린 핵심만 대충 적어보는 겁니다.", "words": [{"s": 93.56, "e": 94.28, "w": " 읽고"}, {"s": 94.28, "e": 94.7, "w": " 내가"}, {"s": 94.7, "e": 95.2, "w": " 떠올린"}, {"s": 95.2, "e": 95.98, "w": " 핵심만"}, {"s": 95.98, "e": 96.64, "w": " 대충"}, {"s": 96.64, "e": 97.3, "w": " 적어보는"}, {"s": 97.3, "e": 97.54, "w": " 겁니다."}]}, {"start": 97.82, "end": 103.34, "text": " 초보들은 이 과정에서 아마 문장을 다시 읽게 될 텐데 괜찮습니다.", "words": [{"s": 97.82, "e": 98.42, "w": " 초보들은"}, {"s": 98.42, "e": 99.0, "w": " 이"}, {"s": 99.0, "e": 99.68, "w": " 과정에서"}, {"s": 99.68, "e": 100.2, "w": " 아마"}, {"s": 100.2, "e": 100.84, "w": " 문장을"}, {"s": 100.84, "e": 101.56, "w": " 다시"}, {"s": 101.56, "e": 101.9, "w": " 읽게"}, {"s": 101.9, "e": 102.06, "w": " 될"}, {"s": 102.06, "e": 102.32, "w": " 텐데"}, {"s": 102.32, "e": 103.34, "w": " 괜찮습니다."}]}, {"start": 103.64, "end": 107.12, "text": " 이렇게 해본 적이 없는데 어떻게 처음부터 읽으면서 사고하나요?", "words": [{"s": 103.64, "e": 103.98, "w": " 이렇게"}, {"s": 103.98, "e": 104.2, "w": " 해본"}, {"s": 104.2, "e": 104.36, "w": " 적이"}, {"s": 104.36, "e": 104.78, "w": " 없는데"}, {"s": 104.78, "e": 105.34, "w": " 어떻게"}, {"s": 105.34, "e": 105.78, "w": " 처음부터"}, {"s": 105.78, "e": 106.22, "w": " 읽으면서"}, {"s": 106.22, "e": 107.12, "w": " 사고하나요?"}]}, {"start": 107.32, "end": 109.32, "text": " 선해석 후사고 괜찮습니다.", "words": [{"s": 107.32, "e": 107.96, "w": " 선해석"}, {"s": 107.96, "e": 108.42, "w": " 후사고"}, {"s": 108.42, "e": 109.32, "w": " 괜찮습니다."}]}, {"start": 109.54, "end": 110.36, "text": " 저도 처음엔 이랬어요.", "words": [{"s": 109.54, "e": 109.7, "w": " 저도"}, {"s": 109.7, "e": 110.02, "w": " 처음엔"}, {"s": 110.02, "e": 110.36, "w": " 이랬어요."}]}, {"start": 110.36, "end": 114.14, "text": " 그리고 가끔 한 문장 가지고 안 적어지는 것도 있을 텐데", "words": [{"s": 110.36, "e": 110.84, "w": " 그리고"}, {"s": 110.84, "e": 111.28, "w": " 가끔"}, {"s": 111.28, "e": 111.84, "w": " 한"}, {"s": 111.84, "e": 112.16, "w": " 문장"}, {"s": 112.16, "e": 112.4, "w": " 가지고"}, {"s": 112.4, "e": 113.02, "w": " 안"}, {"s": 113.02, "e": 113.52, "w": " 적어지는"}, {"s": 113.52, "e": 113.64, "w": " 것도"}, {"s": 113.64, "e": 113.9, "w": " 있을"}, {"s": 113.9, "e": 114.14, "w": " 텐데"}]}, {"start": 114.14, "end": 117.46, "text": " 너무 안 중요하거나 생소한 내용이면 그렇습니다.", "words": [{"s": 114.14, "e": 114.72, "w": " 너무"}, {"s": 114.72, "e": 115.1, "w": " 안"}, {"s": 115.1, "e": 115.68, "w": " 중요하거나"}, {"s": 115.68, "e": 116.4, "w": " 생소한"}, {"s": 116.4, "e": 116.82, "w": " 내용이면"}, {"s": 116.82, "e": 117.46, "w": " 그렇습니다."}]}, {"start": 117.6, "end": 122.36, "text": " 그럴 땐 대충 중요해 보이는 단어라도 적고 넘어가시는 거예요.", "words": [{"s": 117.6, "e": 117.9, "w": " 그럴"}, {"s": 117.9, "e": 118.14, "w": " 땐"}, {"s": 118.14, "e": 118.96, "w": " 대충"}, {"s": 118.96, "e": 119.78, "w": " 중요해"}, {"s": 119.78, "e": 120.0, "w": " 보이는"}, {"s": 120.0, "e": 120.62, "w": " 단어라도"}, {"s": 120.62, "e": 121.38, "w": " 적고"}, {"s": 121.38, "e": 122.14, "w": " 넘어가시는"}, {"s": 122.14, "e": 122.36, "w": " 거예요."}]}, {"start": 124.64, "end": 126.74, "text": " 이전 영상에서 끊어였게 배운 친구들은 알죠?", "words": [{"s": 124.48, "e": 124.9, "w": " 이전"}, {"s": 124.9, "e": 125.4, "w": " 영상에서"}, {"s": 125.4, "e": 125.84, "w": " 끊어였게"}, {"s": 125.84, "e": 126.06, "w": " 배운"}, {"s": 126.06, "e": 126.46, "w": " 친구들은"}, {"s": 126.46, "e": 126.74, "w": " 알죠?"}]}, {"start": 127.08, "end": 130.76, "text": " 끊은 덩어리마다 고개를 들어 생각하고 정리합니다.", "words": [{"s": 127.08, "e": 127.5, "w": " 끊은"}, {"s": 127.5, "e": 128.3, "w": " 덩어리마다"}, {"s": 128.3, "e": 128.84, "w": " 고개를"}, {"s": 128.84, "e": 129.1, "w": " 들어"}, {"s": 129.1, "e": 130.02, "w": " 생각하고"}, {"s": 130.02, "e": 130.76, "w": " 정리합니다."}]}, {"start": 130.92, "end": 133.9, "text": " 끊어였게 안 배운 친구들이나 해석에 약한 친구들은", "words": [{"s": 130.92, "e": 131.32, "w": " 끊어였게"}, {"s": 131.32, "e": 131.46, "w": " 안"}, {"s": 131.46, "e": 131.72, "w": " 배운"}, {"s": 131.72, "e": 132.28, "w": " 친구들이나"}, {"s": 132.28, "e": 132.88, "w": " 해석에"}, {"s": 132.88, "e": 133.42, "w": " 약한"}, {"s": 133.42, "e": 133.9, "w": " 친구들은"}]}, {"start": 133.9, "end": 136.5, "text": " 이 영상 다 보고 이전 영상 봐주세요.", "words": [{"s": 133.9, "e": 134.2, "w": " 이"}, {"s": 134.2, "e": 134.42, "w": " 영상"}, {"s": 134.42, "e": 134.68, "w": " 다"}, {"s": 134.68, "e": 135.08, "w": " 보고"}, {"s": 135.08, "e": 135.6, "w": " 이전"}, {"s": 135.6, "e": 135.94, "w": " 영상"}, {"s": 135.94, "e": 136.5, "w": " 봐주세요."}]}, {"start": 136.5, "end": 139.96, "text": " 자, 첫 번째 덩어리, 시인들이 원한다는데", "words": [{"s": 136.5, "e": 137.04, "w": " 자,"}, {"s": 137.48, "e": 137.48, "w": " 첫"}, {"s": 137.48, "e": 137.76, "w": " 번째"}, {"s": 137.76, "e": 138.1, "w": " 덩어리,"}, {"s": 138.3, "e": 139.0, "w": " 시인들이"}, {"s": 139.0, "e": 139.96, "w": " 원한다는데"}]}, {"start": 139.96, "end": 141.88, "text": " 얘네가 원하는 내용이 중요한 거지", "words": [{"s": 139.96, "e": 140.64, "w": " 얘네가"}, {"s": 140.64, "e": 141.06, "w": " 원하는"}, {"s": 141.06, "e": 141.44, "w": " 내용이"}, {"s": 141.44, "e": 141.66, "w": " 중요한"}, {"s": 141.66, "e": 141.88, "w": " 거지"}]}, {"start": 141.88, "end": 144.28, "text": " 시인들 자체가 지금 중요한 게 아니죠?", "words": [{"s": 141.88, "e": 142.7, "w": " 시인들"}, {"s": 142.7, "e": 143.32, "w": " 자체가"}, {"s": 143.32, "e": 143.56, "w": " 지금"}, {"s": 143.56, "e": 143.86, "w": " 중요한"}, {"s": 143.86, "e": 143.98, "w": " 게"}, {"s": 143.98, "e": 144.28, "w": " 아니죠?"}]}, {"start": 144.42, "end": 146.12, "text": " 아무것도 안 적고 넘어갑니다.", "words": [{"s": 144.42, "e": 144.86, "w": " 아무것도"}, {"s": 144.86, "e": 145.04, "w": " 안"}, {"s": 145.04, "e": 145.32, "w": " 적고"}, {"s": 145.32, "e": 146.12, "w": " 넘어갑니다."}]}, {"start": 146.24, "end": 148.78, "text": " 두 번째 덩어리, 시적인 위대함이라는데", "words": [{"s": 146.24, "e": 146.36, "w": " 두"}, {"s": 146.36, "e": 146.58, "w": " 번째"}, {"s": 146.58, "e": 146.92, "w": " 덩어리,"}, {"s": 147.12, "e": 147.64, "w": " 시적인"}, {"s": 147.64, "e": 148.78, "w": " 위대함이라는데"}]}, {"start": 148.78, "end": 150.68, "text": " 아직 무슨 소린지 모르겠죠?", "words": [{"s": 148.78, "e": 149.28, "w": " 아직"}, {"s": 149.28, "e": 149.58, "w": " 무슨"}, {"s": 149.58, "e": 149.98, "w": " 소린지"}, {"s": 149.98, "e": 150.68, "w": " 모르겠죠?"}]}, {"start": 150.84, "end": 152.24, "text": " 기억만 하고 넘어갑니다.", "words": [{"s": 150.84, "e": 151.32, "w": " 기억만"}, {"s": 151.32, "e": 151.54, "w": " 하고"}, {"s": 151.54, "e": 152.24, "w": " 넘어갑니다."}]}, {"start": 152.44, "end": 153.66, "text": " 자, 세 번째 덩어리인데요.", "words": [{"s": 152.44, "e": 152.56, "w": " 자,"}, {"s": 152.68, "e": 152.82, "w": " 세"}, {"s": 152.82, "e": 153.08, "w": " 번째"}, {"s": 153.08, "e": 153.66, "w": " 덩어리인데요."}]}, {"start": 154.0, "end": 156.86, "text": " 그들에게 불멸성을 준다는데", "words": [{"s": 154.0, "e": 154.58, "w": " 그들에게"}, {"s": 154.58, "e": 155.82, "w": " 불멸성을"}, {"s": 155.82, "e": 156.86, "w": " 준다는데"}]}, {"start": 156.86, "end": 158.92, "text": " 시적인 위대함이 주는 거죠?", "words": [{"s": 156.86, "e": 157.76, "w": " 시적인"}, {"s": 157.76, "e": 158.44, "w": " 위대함이"}, {"s": 158.44, "e": 158.68, "w": " 주는"}, {"s": 158.68, "e": 158.92, "w": " 거죠?"}]}, {"start": 159.14, "end": 160.98, "text": " 그러면 이제 고개를 들고 생각하는 거예요.", "words": [{"s": 159.14, "e": 159.38, "w": " 그러면"}, {"s": 159.38, "e": 159.54, "w": " 이제"}, {"s": 159.54, "e": 159.9, "w": " 고개를"}, {"s": 159.9, "e": 160.24, "w": " 들고"}, {"s": 160.24, "e": 160.84, "w": " 생각하는"}, {"s": 160.84, "e": 160.98, "w": " 거예요."}]}, {"start": 161.08, "end": 163.92, "text": " 아, 시적인 위대함이 뭔가 불멸성을 준다고?", "words": [{"s": 161.08, "e": 161.22, "w": " 아,"}, {"s": 161.3, "e": 161.64, "w": " 시적인"}, {"s": 161.64, "e": 162.16, "w": " 위대함이"}, {"s": 162.16, "e": 162.52, "w": " 뭔가"}, {"s": 162.52, "e": 163.54, "w": " 불멸성을"}, {"s": 163.54, "e": 163.92, "w": " 준다고?"}]}, {"start": 163.92, "end": 167.22, "text": " 그러니까 시를 잘 쓰면 불멸한다는 건가?", "words": [{"s": 163.92, "e": 164.46, "w": " 그러니까"}, {"s": 164.46, "e": 165.04, "w": " 시를"}, {"s": 165.04, "e": 165.66, "w": " 잘"}, {"s": 165.66, "e": 166.12, "w": " 쓰면"}, {"s": 166.12, "e": 166.96, "w": " 불멸한다는"}, {"s": 166.96, "e": 167.22, "w": " 건가?"}]}, {"start": 167.34, "end": 168.0, "text": " 이런 식으로요.", "words": [{"s": 167.34, "e": 167.54, "w": " 이런"}, {"s": 167.54, "e": 168.0, "w": " 식으로요."}]}, {"start": 168.2, "end": 170.66, "text": " 그리고 오른쪽에 간단하게 적는 거죠.", "words": [{"s": 168.2, "e": 168.42, "w": " 그리고"}, {"s": 168.42, "e": 169.2, "w": " 오른쪽에"}, {"s": 169.2, "e": 170.1, "w": " 간단하게"}, {"s": 170.1, "e": 170.48, "w": " 적는"}, {"s": 170.48, "e": 170.66, "w": " 거죠."}]}, {"start": 170.82, "end": 172.44, "text": " 시가 개쩌면 불멸한다.", "words": [{"s": 170.82, "e": 171.1, "w": " 시가"}, {"s": 171.1, "e": 171.68, "w": " 개쩌면"}, {"s": 171.68, "e": 172.44, "w": " 불멸한다."}]}, {"start": 172.58, "end": 174.16, "text": " 이 정도만 적어줘도 충분합니다.", "words": [{"s": 172.58, "e": 172.7, "w": " 이"}, {"s": 172.7, "e": 173.04, "w": " 정도만"}, {"s": 173.04, "e": 173.46, "w": " 적어줘도"}, {"s": 173.46, "e": 174.16, "w": " 충분합니다."}]}, {"start": 174.26, "end": 176.14, "text": " 1단계를 제대로 해줬던 친구들은", "words": [{"s": 174.26, "e": 174.8, "w": " 1단계를"}, {"s": 174.8, "e": 175.24, "w": " 제대로"}, {"s": 175.24, "e": 175.6, "w": " 해줬던"}, {"s": 175.6, "e": 176.14, "w": " 친구들은"}]}, {"start": 176.14, "end": 178.24, "text": " 첫 덩어리를 넘긴 것처럼", "words": [{"s": 176.14, "e": 176.58, "w": " 첫"}, {"s": 176.58, "e": 177.08, "w": " 덩어리를"}, {"s": 177.08, "e": 177.88, "w": " 넘긴"}, {"s": 177.88, "e": 178.24, "w": " 것처럼"}]}, {"start": 178.24, "end": 182.68, "text": " 기억할 필요가 있는 것 그리고 없는 것이 나뉘어질 텐데", "words": [{"s": 178.24, "e": 178.96, "w": " 기억할"}, {"s": 178.96, "e": 179.38, "w": " 필요가"}, {"s": 179.38, "e": 179.9, "w": " 있는"}, {"s": 179.9, "e": 180.2, "w": " 것"}, {"s": 180.2, "e": 180.56, "w": " 그리고"}, {"s": 180.56, "e": 181.18, "w": " 없는"}, {"s": 181.18, "e": 181.66, "w": " 것이"}, {"s": 181.66, "e": 182.44, "w": " 나뉘어질"}, {"s": 182.44, "e": 182.68, "w": " 텐데"}]}, {"start": 182.68, "end": 184.44, "text": " 아주 좋은 현상입니다.", "words": [{"s": 182.68, "e": 183.36, "w": " 아주"}, {"s": 183.36, "e": 183.92, "w": " 좋은"}, {"s": 183.92, "e": 184.44, "w": " 현상입니다."}]}, {"start": 184.58, "end": 186.12, "text": " 많은 텍스트를 읽고 생각함으로써", "words": [{"s": 184.58, "e": 184.86, "w": " 많은"}, {"s": 184.86, "e": 185.3, "w": " 텍스트를"}, {"s": 185.3, "e": 185.48, "w": " 읽고"}, {"s": 185.48, "e": 186.12, "w": " 생각함으로써"}]}, {"start": 186.12, "end": 190.14, "text": " 기억할 정보와 버릴 정보가 어떤 식으로 구성되어 있는지 체화한 거예요.", "words": [{"s": 186.12, "e": 186.78, "w": " 기억할"}, {"s": 186.78, "e": 187.16, "w": " 정보와"}, {"s": 187.16, "e": 187.58, "w": " 버릴"}, {"s": 187.58, "e": 188.04, "w": " 정보가"}, {"s": 188.04, "e": 188.5, "w": " 어떤"}, {"s": 188.5, "e": 188.76, "w": " 식으로"}, {"s": 188.76, "e": 189.2, "w": " 구성되어"}, {"s": 189.2, "e": 189.52, "w": " 있는지"}, {"s": 189.52, "e": 190.0, "w": " 체화한"}, {"s": 190.0, "e": 190.14, "w": " 거예요."}]}, {"start": 190.3, "end": 193.5, "text": " 이걸 계속하면 덩어리마다 굳이 고개를 들지 않아도", "words": [{"s": 190.3, "e": 190.5, "w": " 이걸"}, {"s": 190.5, "e": 191.14, "w": " 계속하면"}, {"s": 191.14, "e": 192.0, "w": " 덩어리마다"}, {"s": 192.0, "e": 192.48, "w": " 굳이"}, {"s": 192.48, "e": 192.78, "w": " 고개를"}, {"s": 192.78, "e": 193.1, "w": " 들지"}, {"s": 193.1, "e": 193.5, "w": " 않아도"}]}, {"start": 193.5, "end": 196.52, "text": " 그냥 읽으면서 아 뭐라는 거구나 바로 떠오릅니다.", "words": [{"s": 193.5, "e": 193.94, "w": " 그냥"}, {"s": 193.94, "e": 194.44, "w": " 읽으면서"}, {"s": 194.44, "e": 194.84, "w": " 아"}, {"s": 194.84, "e": 195.2, "w": " 뭐라는"}, {"s": 195.2, "e": 195.5, "w": " 거구나"}, {"s": 195.5, "e": 196.0, "w": " 바로"}, {"s": 196.0, "e": 196.52, "w": " 떠오릅니다."}]}, {"start": 196.7, "end": 200.56, "text": " 그리고 두 번째 덩어리처럼 읽고 나서 2, 3초 정도 고민해도", "words": [{"s": 196.7, "e": 196.96, "w": " 그리고"}, {"s": 196.96, "e": 197.22, "w": " 두"}, {"s": 197.22, "e": 197.54, "w": " 번째"}, {"s": 197.54, "e": 198.04, "w": " 덩어리처럼"}, {"s": 198.04, "e": 198.8, "w": " 읽고"}, {"s": 198.8, "e": 198.98, "w": " 나서"}, {"s": 198.98, "e": 199.4, "w": " 2,"}, {"s": 199.52, "e": 199.74, "w": " 3초"}, {"s": 199.74, "e": 199.96, "w": " 정도"}, {"s": 199.96, "e": 200.56, "w": " 고민해도"}]}, {"start": 200.56, "end": 204.28, "text": " 뭐라는지 모르겠는 것들은 그냥 방금처럼 더 읽어주시면 돼요.", "words": [{"s": 200.56, "e": 201.32, "w": " 뭐라는지"}, {"s": 201.32, "e": 201.9, "w": " 모르겠는"}, {"s": 201.9, "e": 202.3, "w": " 것들은"}, {"s": 202.3, "e": 202.66, "w": " 그냥"}, {"s": 202.66, "e": 203.28, "w": " 방금처럼"}, {"s": 203.28, "e": 203.66, "w": " 더"}, {"s": 203.66, "e": 204.12, "w": " 읽어주시면"}, {"s": 204.12, "e": 204.28, "w": " 돼요."}]}, {"start": 204.54, "end": 207.94, "text": " 원래 정보량이 부족하거나 해당 텍스트가 중요하지 않으면", "words": [{"s": 204.54, "e": 204.8, "w": " 원래"}, {"s": 204.8, "e": 205.36, "w": " 정보량이"}, {"s": 205.36, "e": 205.9, "w": " 부족하거나"}, {"s": 205.9, "e": 206.4, "w": " 해당"}, {"s": 206.4, "e": 207.0, "w": " 텍스트가"}, {"s": 207.0, "e": 207.54, "w": " 중요하지"}, {"s": 207.54, "e": 207.94, "w": " 않으면"}]}, {"start": 207.94, "end": 210.76, "text": " 머릿속에 아무것도 안 남는 게 정상이에요.", "words": [{"s": 207.94, "e": 208.72, "w": " 머릿속에"}, {"s": 208.72, "e": 209.24, "w": " 아무것도"}, {"s": 209.24, "e": 209.5, "w": " 안"}, {"s": 209.5, "e": 209.82, "w": " 남는"}, {"s": 209.82, "e": 209.96, "w": " 게"}, {"s": 209.96, "e": 210.76, "w": " 정상이에요."}]}, {"start": 211.02, "end": 213.14, "text": " 3단계 문장을 연결해봅니다.", "words": [{"s": 211.02, "e": 211.42, "w": " 3단계"}, {"s": 211.42, "e": 212.0, "w": " 문장을"}, {"s": 212.0, "e": 213.14, "w": " 연결해봅니다."}]}, {"start": 213.36, "end": 214.62, "text": " 즉 공통점을 찾는 건데요.", "words": [{"s": 213.36, "e": 213.54, "w": " 즉"}, {"s": 213.54, "e": 214.1, "w": " 공통점을"}, {"s": 214.1, "e": 214.32, "w": " 찾는"}, {"s": 214.32, "e": 214.62, "w": " 건데요."}]}, {"start": 214.86, "end": 218.66, "text": " 네 번째 문장에서 휘트먼이 페이지에서 영원히 사는 것에", "words": [{"s": 214.86, "e": 214.96, "w": " 네"}, {"s": 214.96, "e": 215.26, "w": " 번째"}, {"s": 215.26, "e": 215.94, "w": " 문장에서"}, {"s": 215.94, "e": 216.82, "w": " 휘트먼이"}, {"s": 216.82, "e": 217.58, "w": " 페이지에서"}, {"s": 217.58, "e": 218.16, "w": " 영원히"}, {"s": 218.16, "e": 218.38, "w": " 사는"}, {"s": 218.38, "e": 218.66, "w": " 것에"}]}, {"start": 218.66, "end": 221.3, "text": " 새로운 명성을 더했다고 합니다.", "words": [{"s": 218.66, "e": 219.42, "w": " 새로운"}, {"s": 219.42, "e": 220.14, "w": " 명성을"}, {"s": 220.14, "e": 221.06, "w": " 더했다고"}, {"s": 221.06, "e": 221.3, "w": " 합니다."}]}, {"start": 221.3, "end": 225.16, "text": " 뒷문장을 보니 독자들이 작품뿐만 아니라", "words": [{"s": 221.3, "e": 221.98, "w": " 뒷문장을"}, {"s": 221.98, "e": 222.38, "w": " 보니"}, {"s": 222.38, "e": 223.42, "w": " 독자들이"}, {"s": 223.42, "e": 224.84, "w": " 작품뿐만"}, {"s": 224.84, "e": 225.16, "w": " 아니라"}]}, {"start": 225.16, "end": 229.86, "text": " 그의 퍼소널리티에도 끌렸으면 좋겠다고 되어 있는데", "words": [{"s": 225.16, "e": 226.24, "w": " 그의"}, {"s": 226.24, "e": 227.62, "w": " 퍼소널리티에도"}, {"s": 227.62, "e": 228.46, "w": " 끌렸으면"}, {"s": 228.46, "e": 229.12, "w": " 좋겠다고"}, {"s": 229.12, "e": 229.52, "w": " 되어"}, {"s": 229.52, "e": 229.86, "w": " 있는데"}]}, {"start": 229.86, "end": 230.56, "text": " 그럼 어때요?", "words": [{"s": 229.86, "e": 230.26, "w": " 그럼"}, {"s": 230.26, "e": 230.56, "w": " 어때요?"}]}, {"start": 230.7, "end": 232.36, "text": " 이게 새 명성이겠죠.", "words": [{"s": 230.7, "e": 231.02, "w": " 이게"}, {"s": 231.02, "e": 231.56, "w": " 새"}, {"s": 231.56, "e": 232.36, "w": " 명성이겠죠."}]}, {"start": 232.52, "end": 234.0, "text": " 왜냐하면 페이지에서 영원히 사는 거는", "words": [{"s": 232.52, "e": 232.74, "w": " 왜냐하면"}, {"s": 232.74, "e": 233.3, "w": " 페이지에서"}, {"s": 233.3, "e": 233.64, "w": " 영원히"}, {"s": 233.64, "e": 233.82, "w": " 사는"}, {"s": 233.82, "e": 234.0, "w": " 거는"}]}, {"start": 234.0, "end": 236.56, "text": " 이미 앞에 나온 불멸이랑 같은 말이니까", "words": [{"s": 234.0, "e": 234.4, "w": " 이미"}, {"s": 234.4, "e": 234.68, "w": " 앞에"}, {"s": 234.68, "e": 234.92, "w": " 나온"}, {"s": 234.92, "e": 235.52, "w": " 불멸이랑"}, {"s": 235.52, "e": 236.06, "w": " 같은"}, {"s": 236.06, "e": 236.56, "w": " 말이니까"}]}, {"start": 236.56, "end": 241.22, "text": " 뉴빼임은 당연히 그의 퍼소널리티에 끌리는 거 말고는 없겠죠.", "words": [{"s": 236.56, "e": 237.86, "w": " 뉴빼임은"}, {"s": 237.86, "e": 238.74, "w": " 당연히"}, {"s": 238.74, "e": 239.2, "w": " 그의"}, {"s": 239.2, "e": 240.12, "w": " 퍼소널리티에"}, {"s": 240.12, "e": 240.54, "w": " 끌리는"}, {"s": 240.54, "e": 240.62, "w": " 거"}, {"s": 240.62, "e": 240.92, "w": " 말고는"}, {"s": 240.92, "e": 241.22, "w": " 없겠죠."}]}, {"start": 241.46, "end": 245.2, "text": " 즉 이어지는 문장들에서 무엇이 반복되는지 공통점만 찾으면 됩니다.", "words": [{"s": 241.46, "e": 241.68, "w": " 즉"}, {"s": 241.68, "e": 242.08, "w": " 이어지는"}, {"s": 242.08, "e": 242.6, "w": " 문장들에서"}, {"s": 242.6, "e": 243.14, "w": " 무엇이"}, {"s": 243.14, "e": 243.88, "w": " 반복되는지"}, {"s": 243.88, "e": 244.6, "w": " 공통점만"}, {"s": 244.6, "e": 244.98, "w": " 찾으면"}, {"s": 244.98, "e": 245.2, "w": " 됩니다."}]}, {"start": 245.46, "end": 247.34, "text": " 왔다 갔다 하셔도 상관없어요.", "words": [{"s": 245.46, "e": 245.78, "w": " 왔다"}, {"s": 245.78, "e": 246.08, "w": " 갔다"}, {"s": 246.08, "e": 246.38, "w": " 하셔도"}, {"s": 246.38, "e": 247.34, "w": " 상관없어요."}]}, {"start": 247.62, "end": 251.06, "text": " 4단계 왔다 갔다 하지 않고 연결성을 생각해봅니다.", "words": [{"s": 247.62, "e": 248.1, "w": " 4단계"}, {"s": 248.1, "e": 248.68, "w": " 왔다"}, {"s": 248.68, "e": 248.94, "w": " 갔다"}, {"s": 248.94, "e": 249.1, "w": " 하지"}, {"s": 249.1, "e": 249.38, "w": " 않고"}, {"s": 249.38, "e": 250.38, "w": " 연결성을"}, {"s": 250.38, "e": 251.06, "w": " 생각해봅니다."}]}, {"start": 251.06, "end": 254.32, "text": " 앞 문장을 다시 보지 않고 공통점을 떠올리시면 돼요.", "words": [{"s": 251.06, "e": 251.4, "w": " 앞"}, {"s": 251.4, "e": 251.8, "w": " 문장을"}, {"s": 251.8, "e": 252.08, "w": " 다시"}, {"s": 252.08, "e": 252.42, "w": " 보지"}, {"s": 252.42, "e": 252.68, "w": " 않고"}, {"s": 252.68, "e": 253.52, "w": " 공통점을"}, {"s": 253.52, "e": 254.08, "w": " 떠올리시면"}, {"s": 254.08, "e": 254.32, "w": " 돼요."}]}, {"start": 254.52, "end": 260.88, "text": " 자 이 문장에서 휘트먼이 대중과 관련하여 명성을 정의했다고 되어 있는데", "words": [{"s": 254.52, "e": 254.72, "w": " 자"}, {"s": 254.72, "e": 255.08, "w": " 이"}, {"s": 255.08, "e": 255.98, "w": " 문장에서"}, {"s": 255.98, "e": 256.94, "w": " 휘트먼이"}, {"s": 256.94, "e": 257.8, "w": " 대중과"}, {"s": 257.8, "e": 258.42, "w": " 관련하여"}, {"s": 258.42, "e": 259.28, "w": " 명성을"}, {"s": 259.28, "e": 260.32, "w": " 정의했다고"}, {"s": 260.32, "e": 260.54, "w": " 되어"}, {"s": 260.54, "e": 260.88, "w": " 있는데"}]}, {"start": 260.88, "end": 262.62, "text": " 고개를 들고 생각해 보는 거예요.", "words": [{"s": 260.88, "e": 261.48, "w": " 고개를"}, {"s": 261.48, "e": 261.8, "w": " 들고"}, {"s": 261.8, "e": 262.34, "w": " 생각해"}, {"s": 262.34, "e": 262.48, "w": " 보는"}, {"s": 262.48, "e": 262.62, "w": " 거예요."}]}, {"start": 262.76, "end": 264.88, "text": " 앞에 내용과 공통점이 뭐지?", "words": [{"s": 262.76, "e": 262.96, "w": " 앞에"}, {"s": 262.96, "e": 263.4, "w": " 내용과"}, {"s": 263.4, "e": 264.38, "w": " 공통점이"}, {"s": 264.38, "e": 264.88, "w": " 뭐지?"}]}, {"start": 265.14, "end": 269.56, "text": " 네 앞에서 독자가 자기 개성에 끌렸으면 좋겠다고 했는데", "words": [{"s": 265.14, "e": 265.28, "w": " 네"}, {"s": 265.28, "e": 266.08, "w": " 앞에서"}, {"s": 266.08, "e": 266.92, "w": " 독자가"}, {"s": 266.92, "e": 267.54, "w": " 자기"}, {"s": 267.54, "e": 268.02, "w": " 개성에"}, {"s": 268.02, "e": 268.62, "w": " 끌렸으면"}, {"s": 268.62, "e": 269.26, "w": " 좋겠다고"}, {"s": 269.26, "e": 269.56, "w": " 했는데"}]}, {"start": 269.56, "end": 271.32, "text": " 대중이 누구예요? 독자죠.", "words": [{"s": 269.56, "e": 270.28, "w": " 대중이"}, {"s": 270.28, "e": 270.66, "w": " 누구예요?"}, {"s": 270.78, "e": 271.32, "w": " 독자죠."}]}, {"start": 271.54, "end": 276.58, "text": " 즉 휘트먼이 원한 건 독자 또는 대중이 자기에게 끌리는 거 그걸 원했던 거죠.", "words": [{"s": 271.54, "e": 271.7, "w": " 즉"}, {"s": 271.7, "e": 272.24, "w": " 휘트먼이"}, {"s": 272.24, "e": 272.54, "w": " 원한"}, {"s": 272.54, "e": 272.7, "w": " 건"}, {"s": 272.7, "e": 273.28, "w": " 독자"}, {"s": 273.28, "e": 273.76, "w": " 또는"}, {"s": 273.76, "e": 274.36, "w": " 대중이"}, {"s": 274.36, "e": 275.06, "w": " 자기에게"}, {"s": 275.06, "e": 275.6, "w": " 끌리는"}, {"s": 275.6, "e": 275.72, "w": " 거"}, {"s": 275.72, "e": 276.06, "w": " 그걸"}, {"s": 276.06, "e": 276.38, "w": " 원했던"}, {"s": 276.38, "e": 276.58, "w": " 거죠."}]}, {"start": 276.72, "end": 279.32, "text": " 그럼 빈칸도 보고 답도 맞춰볼까요?", "words": [{"s": 276.72, "e": 276.92, "w": " 그럼"}, {"s": 276.92, "e": 277.8, "w": " 빈칸도"}, {"s": 277.8, "e": 278.08, "w": " 보고"}, {"s": 278.08, "e": 278.74, "w": " 답도"}, {"s": 278.74, "e": 279.32, "w": " 맞춰볼까요?"}]}, {"start": 279.32, "end": 285.6, "text": " 자 빈칸에서 휘트머니 추구한 거라고 되어 있는데 휘트머니 추구했던 게 뭐죠?", "words": [{"s": 279.32, "e": 279.66, "w": " 자"}, {"s": 279.66, "e": 280.58, "w": " 빈칸에서"}, {"s": 280.58, "e": 281.54, "w": " 휘트머니"}, {"s": 281.54, "e": 282.52, "w": " 추구한"}, {"s": 282.52, "e": 282.98, "w": " 거라고"}, {"s": 282.98, "e": 283.48, "w": " 되어"}, {"s": 283.48, "e": 283.92, "w": " 있는데"}, {"s": 283.92, "e": 284.74, "w": " 휘트머니"}, {"s": 284.74, "e": 285.16, "w": " 추구했던"}, {"s": 285.16, "e": 285.34, "w": " 게"}, {"s": 285.34, "e": 285.6, "w": " 뭐죠?"}]}, {"start": 285.74, "end": 287.9, "text": " 대중이 자기 개성에게 끌리는 거잖아요.", "words": [{"s": 285.74, "e": 286.32, "w": " 대중이"}, {"s": 286.32, "e": 286.58, "w": " 자기"}, {"s": 286.58, "e": 287.12, "w": " 개성에게"}, {"s": 287.12, "e": 287.56, "w": " 끌리는"}, {"s": 287.56, "e": 287.9, "w": " 거잖아요."}]}, {"start": 288.04, "end": 290.62, "text": " 그럼 답은? 네 당연히 4번이죠.", "words": [{"s": 288.04, "e": 288.22, "w": " 그럼"}, {"s": 288.22, "e": 288.6, "w": " 답은?"}, {"s": 288.74, "e": 288.84, "w": " 네"}, {"s": 288.84, "e": 289.56, "w": " 당연히"}, {"s": 289.56, "e": 290.62, "w": " 4번이죠."}]}, {"start": 290.78, "end": 294.04, "text": " 그의 동시대인들의 인정. 동시대인이 대중이죠.", "words": [{"s": 290.78, "e": 291.08, "w": " 그의"}, {"s": 291.08, "e": 292.18, "w": " 동시대인들의"}, {"s": 292.18, "e": 292.64, "w": " 인정."}, {"s": 292.74, "e": 293.38, "w": " 동시대인이"}, {"s": 293.38, "e": 294.04, "w": " 대중이죠."}]}, {"start": 294.24, "end": 298.2, "text": " 그리고 그들의 인정은 즉 자기한테 끌렸다는 소리고요.", "words": [{"s": 294.24, "e": 294.4, "w": " 그리고"}, {"s": 294.4, "e": 295.0, "w": " 그들의"}, {"s": 295.0, "e": 295.82, "w": " 인정은"}, {"s": 295.82, "e": 296.24, "w": " 즉"}, {"s": 296.24, "e": 296.88, "w": " 자기한테"}, {"s": 296.88, "e": 297.6, "w": " 끌렸다는"}, {"s": 297.6, "e": 298.2, "w": " 소리고요."}]}, {"start": 298.32, "end": 303.46, "text": " 애초에 앞부분에서 중요 정보를 캐치했다면 다음 문장들을 읽으면서", "words": [{"s": 298.32, "e": 298.98, "w": " 애초에"}, {"s": 298.98, "e": 300.12, "w": " 앞부분에서"}, {"s": 300.12, "e": 300.62, "w": " 중요"}, {"s": 300.62, "e": 301.12, "w": " 정보를"}, {"s": 301.12, "e": 302.0, "w": " 캐치했다면"}, {"s": 302.0, "e": 302.44, "w": " 다음"}, {"s": 302.44, "e": 303.0, "w": " 문장들을"}, {"s": 303.0, "e": 303.46, "w": " 읽으면서"}]}, {"start": 303.46, "end": 308.08, "text": " 어떤 내용이 공통적으로 제시되고 있는지 느껴질 겁니다.", "words": [{"s": 303.46, "e": 304.1, "w": " 어떤"}, {"s": 304.1, "e": 304.6, "w": " 내용이"}, {"s": 304.6, "e": 305.64, "w": " 공통적으로"}, {"s": 305.64, "e": 306.68, "w": " 제시되고"}, {"s": 306.68, "e": 307.18, "w": " 있는지"}, {"s": 307.18, "e": 307.84, "w": " 느껴질"}, {"s": 307.84, "e": 308.08, "w": " 겁니다."}]}, {"start": 308.08, "end": 311.16, "text": " 그리고 이렇게 하면 완벽한 이해를 하지 못해도", "words": [{"s": 308.08, "e": 308.5, "w": " 그리고"}, {"s": 308.5, "e": 308.72, "w": " 이렇게"}, {"s": 308.72, "e": 308.94, "w": " 하면"}, {"s": 308.94, "e": 309.88, "w": " 완벽한"}, {"s": 309.88, "e": 310.3, "w": " 이해를"}, {"s": 310.3, "e": 310.72, "w": " 하지"}, {"s": 310.72, "e": 311.16, "w": " 못해도"}]}, {"start": 311.16, "end": 313.22, "text": " 반복되는 정보가 느껴지고", "words": [{"s": 311.16, "e": 312.22, "w": " 반복되는"}, {"s": 312.22, "e": 312.66, "w": " 정보가"}, {"s": 312.66, "e": 313.22, "w": " 느껴지고"}]}, {"start": 313.22, "end": 316.08, "text": " 그러면 하려는 말이 뭔지 알게 되죠.", "words": [{"s": 313.22, "e": 313.78, "w": " 그러면"}, {"s": 313.78, "e": 314.72, "w": " 하려는"}, {"s": 314.72, "e": 314.92, "w": " 말이"}, {"s": 314.92, "e": 315.28, "w": " 뭔지"}, {"s": 315.28, "e": 315.84, "w": " 알게"}, {"s": 315.84, "e": 316.08, "w": " 되죠."}]}, {"start": 316.34, "end": 320.4, "text": " 그래서 읽으면서 공통점을 찾는 게 중요한 겁니다.", "words": [{"s": 316.34, "e": 316.68, "w": " 그래서"}, {"s": 316.68, "e": 317.78, "w": " 읽으면서"}, {"s": 317.78, "e": 319.06, "w": " 공통점을"}, {"s": 319.06, "e": 319.34, "w": " 찾는"}, {"s": 319.34, "e": 319.48, "w": " 게"}, {"s": 319.48, "e": 320.12, "w": " 중요한"}, {"s": 320.12, "e": 320.4, "w": " 겁니다."}]}, {"start": 320.6, "end": 322.46, "text": " 자 이제 요약도 해드릴게요.", "words": [{"s": 320.6, "e": 320.7, "w": " 자"}, {"s": 320.7, "e": 320.94, "w": " 이제"}, {"s": 320.94, "e": 321.88, "w": " 요약도"}, {"s": 321.88, "e": 322.46, "w": " 해드릴게요."}]}, {"start": 322.66, "end": 324.02, "text": " 친절한 누보쌤입니다.", "words": [{"s": 322.66, "e": 323.38, "w": " 친절한"}, {"s": 323.38, "e": 324.02, "w": " 누보쌤입니다."}]}, {"start": 324.22, "end": 326.34, "text": " 1단계 한 문장 읽고 생각하기", "words": [{"s": 324.22, "e": 324.64, "w": " 1단계"}, {"s": 324.64, "e": 324.98, "w": " 한"}, {"s": 324.98, "e": 325.34, "w": " 문장"}, {"s": 325.34, "e": 325.68, "w": " 읽고"}, {"s": 325.68, "e": 326.34, "w": " 생각하기"}]}, {"start": 326.34, "end": 328.52, "text": " 2단계 덩어리 읽고 생각하기", "words": [{"s": 326.34, "e": 326.96, "w": " 2단계"}, {"s": 326.96, "e": 327.54, "w": " 덩어리"}, {"s": 327.54, "e": 327.84, "w": " 읽고"}, {"s": 327.84, "e": 328.52, "w": " 생각하기"}]}, {"start": 328.52, "end": 332.14, "text": " 3단계 연결 문장 읽고 공통점 찾기", "words": [{"s": 328.52, "e": 329.38, "w": " 3단계"}, {"s": 329.38, "e": 330.2, "w": " 연결"}, {"s": 330.2, "e": 330.62, "w": " 문장"}, {"s": 330.62, "e": 331.06, "w": " 읽고"}, {"s": 331.06, "e": 331.76, "w": " 공통점"}, {"s": 331.76, "e": 332.14, "w": " 찾기"}]}, {"start": 332.14, "end": 333.82, "text": " 왔다 갔다 해도 오케이", "words": [{"s": 332.14, "e": 332.76, "w": " 왔다"}, {"s": 332.76, "e": 333.14, "w": " 갔다"}, {"s": 333.14, "e": 333.32, "w": " 해도"}, {"s": 333.32, "e": 333.82, "w": " 오케이"}]}, {"start": 333.82, "end": 336.2, "text": " 4단계 3단계랑 똑같은데", "words": [{"s": 333.82, "e": 334.74, "w": " 4단계"}, {"s": 334.74, "e": 335.5, "w": " 3단계랑"}, {"s": 335.5, "e": 336.2, "w": " 똑같은데"}]}, {"start": 336.2, "end": 337.8, "text": " 왔다갔다 금지!", "words": [{"s": 336.2, "e": 337.3, "w": " 왔다갔다"}, {"s": 337.3, "e": 337.8, "w": " 금지!"}]}, {"start": 337.92, "end": 340.86, "text": " 앞으로 이 방법으로 연습하시면", "words": [{"s": 337.92, "e": 338.3, "w": " 앞으로"}, {"s": 338.3, "e": 338.74, "w": " 이"}, {"s": 338.74, "e": 339.54, "w": " 방법으로"}, {"s": 339.54, "e": 340.86, "w": " 연습하시면"}]}, {"start": 340.86, "end": 343.54, "text": " 장담컨대 한 달이면 돋게 됩니다.", "words": [{"s": 340.86, "e": 341.9, "w": " 장담컨대"}, {"s": 341.9, "e": 342.24, "w": " 한"}, {"s": 342.24, "e": 342.7, "w": " 달이면"}, {"s": 342.7, "e": 343.2, "w": " 돋게"}, {"s": 343.2, "e": 343.54, "w": " 됩니다."}]}, {"start": 343.8, "end": 346.58, "text": " 도움이 되셨다면 구독과 좋아요 부탁드리고", "words": [{"s": 343.8, "e": 344.1, "w": " 도움이"}, {"s": 344.1, "e": 344.64, "w": " 되셨다면"}, {"s": 344.64, "e": 345.38, "w": " 구독과"}, {"s": 345.38, "e": 345.82, "w": " 좋아요"}, {"s": 345.82, "e": 346.58, "w": " 부탁드리고"}]}, {"start": 346.58, "end": 350.5, "text": " 다음 영상으로는 해석이 바로 뚫리는 빈출 구문이나", "words": [{"s": 346.58, "e": 347.04, "w": " 다음"}, {"s": 347.04, "e": 347.84, "w": " 영상으로는"}, {"s": 347.84, "e": 348.4, "w": " 해석이"}, {"s": 348.4, "e": 348.8, "w": " 바로"}, {"s": 348.8, "e": 349.3, "w": " 뚫리는"}, {"s": 349.3, "e": 349.94, "w": " 빈출"}, {"s": 349.94, "e": 350.5, "w": " 구문이나"}]}, {"start": 350.5, "end": 353.24, "text": " 딱 한 달이면 해석 실력도 같이 오르는", "words": [{"s": 350.5, "e": 350.78, "w": " 딱"}, {"s": 350.78, "e": 351.16, "w": " 한"}, {"s": 351.16, "e": 351.48, "w": " 달이면"}, {"s": 351.48, "e": 351.92, "w": " 해석"}, {"s": 351.92, "e": 352.32, "w": " 실력도"}, {"s": 352.32, "e": 352.76, "w": " 같이"}, {"s": 352.76, "e": 353.24, "w": " 오르는"}]}, {"start": 353.24, "end": 355.32, "text": " 영단어 암기법 올려드릴게요.", "words": [{"s": 353.24, "e": 353.98, "w": " 영단어"}, {"s": 353.98, "e": 354.66, "w": " 암기법"}, {"s": 354.66, "e": 355.32, "w": " 올려드릴게요."}]}, {"start": 355.48, "end": 357.56, "text": " 누보쌤과 함께하는 노베탈출 파이팅!", "words": [{"s": 355.48, "e": 356.08, "w": " 누보쌤과"}, {"s": 356.08, "e": 356.48, "w": " 함께하는"}, {"s": 356.48, "e": 357.16, "w": " 노베탈출"}, {"s": 357.16, "e": 357.56, "w": " 파이팅!"}]}]