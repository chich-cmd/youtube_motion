"lines": [
{
"s": 0.0,
"e": 1.52,
"text": "영어 해석할 때 다시"
},
{
"s": 1.52,
"e": 3.0,
"text": "{되돌아가는} 학생들 {주목}!"
},
{
"s": 3.0,
"e": 4.26,
"text": "영어 시간 부족한 친구들"
},
{
"s": 4.26,
"e": 5.28,
"text": "이렇게 읽지 않아?"
},
{
"s": 5.38,
"e": 6.82,
"text": "나는 만났다"
},
{
"s": 6.82,
"e": 8.42,
"text": "한 친절한 여자를"
},
{
"s": 8.42,
"e": 11.22,
"text": "3개 국어를 말하는"
},
{
"s": 11.38,
"e": 14.38,
"text": "굉장히 잘 3개 국어를 말하는"
},
{
"s": 14.38,
"e": 16.48,
"text": "친절한 여자를 만났다"
},
{
"s": 16.66,
"e": 18.34,
"text": "쌤이 영어 안 막히고"
},
{
"s": 18.34,
"e": 20.77,
"text": "{쭉쭉 한 번에} 읽는 법 알려줄게"
},
{
"s": 20.85,
"e": 23.15,
"text": "자, 관계사는 그냥 {연결어}"
},
{
"s": 23.15,
"e": 24.35,
"text": "관계사를 보면"
},
{
"s": 24.35,
"e": 26.29,
"text": "\"근데? 뭔데? 누군데?\"라고"
},
{
"s": 26.29,
"e": 27.77,
"text": "{질문}을 하면 끝나"
},
{
"s": 27.95,
"e": 29.01,
"text": "나는 만났다"
},
{
"s": 29.01,
"e": 30.13,
"text": "한 친절한 여자를"
},
{
"s": 30.13,
"e": 31.23,
"text": "{누군데}?"
},
{
"s": 31.23,
"e": 32.83,
"text": "아~ {3개 국어를 잘하는}?"
},
{
"s": 32.95,
"e": 34.83,
"text": "{who}? 누군데? 누구냐면"
},
{
"s": 34.83,
"e": 37.43,
"text": "{which, that}? 뭔데? 뭐냐면"
},
{
"s": 37.43,
"e": 40.15,
"text": "{when}? 언젠데? 언제냐면"
},
{
"s": 40.15,
"e": 41.97,
"text": "{where}? 어딘데? 어디냐면"
},
{
"s": 42.11,
"e": 43.59,
"text": "앞으로 이거 두 개만 기억하세요"
},
{
"s": 43.59,
"e": 46.63,
"text": "① 관계사가 보이면 {맞는 질문}하기"
},
{
"s": 46.63,
"e": 50.38,
"text": "② \"아~\" 하면서 {이해한 듯} 이어 해석"
},
{
"s": 50.52,
"e": 52.0,
"text": "{누보쌤 팔로우} 해두세요!"
}
],
