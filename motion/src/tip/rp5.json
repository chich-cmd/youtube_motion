"lines": [
{
"s": 0.0,
"e": 1.52,
"text": "영어 해석할 때 다시"
},
{
"s": 1.52,
"e": 3.0,
"text": "{되돌아가는} 학생들 {주목}!"
},
{
"s": 3.0,
"e": 4.26,
"text": "영어 시간 부족한 친구들"
},
{
"s": 4.26,
"e": 5.36,
"text": "이렇게 읽지 않아?"
},
{
"s": 5.36,
"e": 6.8,
"text": "나는 만났다"
},
{
"s": 6.8,
"e": 8.4,
"text": "한 친절한 여자를"
},
{
"s": 8.4,
"e": 11.32,
"text": "3개 국어를 말하는"
},
{
"s": 11.32,
"e": 12.86,
"text": "굉장히 잘"
},
{
"s": 12.86,
"e": 15.86,
"text": "굉장히 잘 3개 국어를 말하는"
},
{
"s": 15.86,
"e": 17.96,
"text": "친절한 여자를 만났다"
},
{
"s": 17.96,
"e": 18.92,
"text": "어때?"
},
{
"s": 18.92,
"e": 21.64,
"text": "문제 다 풀 시간이 절대 안 남겠지?"
},
{
"s": 21.64,
"e": 23.32,
"text": "쌤이 영어 안 막히고"
},
{
"s": 23.32,
"e": 25.78,
"text": "{쭉쭉 한 번에} 읽는 법 알려줄게"
},
{
"s": 25.78,
"e": 27.02,
"text": "어순대로 해석하기 위한"
},
{
"s": 27.02,
"e": 28.1,
"text": "구문 중 가장 중요한"
},
{
"s": 28.1,
"e": 30.08,
"text": "{관계사}부터 설명할게"
},
{
"s": 30.08,
"e": 32.38,
"text": "자, 관계사는 그냥 {연결어}"
},
{
"s": 32.38,
"e": 33.58,
"text": "관계사를 보면"
},
{
"s": 33.58,
"e": 35.52,
"text": "\"근데? 뭔데? 누군데?\"라고"
},
{
"s": 35.52,
"e": 37.12,
"text": "{질문}을 하면 끝나"
},
{
"s": 37.12,
"e": 38.18,
"text": "나는 만났다"
},
{
"s": 38.18,
"e": 39.3,
"text": "한 친절한 여자를"
},
{
"s": 39.3,
"e": 40.4,
"text": "{누군데}?"
},
{
"s": 40.4,
"e": 42.06,
"text": "아~ {3개 국어를 잘하는}?"
},
{
"s": 42.06,
"e": 44.42,
"text": "어때? 앞에서부터 잘 읽히고"
},
{
"s": 44.42,
"e": 45.4,
"text": "이해도 되지?"
},
{
"s": 45.4,
"e": 47.64,
"text": "질문하고 답변하는 과정에서"
},
{
"s": 47.64,
"e": 49.6,
"text": "뇌가 {납득}했기 때문이야"
},
{
"s": 49.6,
"e": 51.54,
"text": "그러니까 앞으로 관계사가 보이면"
},
{
"s": 51.54,
"e": 53.18,
"text": "이 질문만 던져봐"
},
{
"s": 53.18,
"e": 55.06,
"text": "{who}? 누군데? 누구냐면"
},
{
"s": 55.06,
"e": 57.66,
"text": "{which, that}? 뭔데? 뭐냐면"
},
{
"s": 57.66,
"e": 60.38,
"text": "{when}? 언젠데? 언제냐면"
},
{
"s": 60.38,
"e": 62.24,
"text": "{where}? 어딘데? 어디냐면"
},
{
"s": 62.24,
"e": 63.82,
"text": "이렇게 앞에서부터 끝까지"
},
{
"s": 63.82,
"e": 65.32,
"text": "쭉 {직진}하는 거야"
},
{
"s": 65.32,
"e": 66.84,
"text": "자, 예문 더 보면서"
},
{
"s": 66.84,
"e": 68.1,
"text": "같이 연습해보자"
},
{
"s": 68.1,
"e": 70.12,
"text": "첫 번째, 그녀는 결혼했다"
},
{
"s": 70.12,
"e": 71.06,
"text": "한 남자랑"
},
{
"s": 71.06,
"e": 72.14,
"text": "{누군데}?"
},
{
"s": 72.14,
"e": 73.52,
"text": "아~ {그녀 상사였던}"
},
{
"s": 73.52,
"e": 75.76,
"text": "두 번째, 그는 연설했다"
},
{
"s": 75.76,
"e": 77.28,
"text": "{근데 그게}?"
},
{
"s": 77.28,
"e": 78.82,
"text": "아~ {모두를 놀래켰다고}"
},
{
"s": 78.82,
"e": 81.66,
"text": "세 번째, 나는 여전히 기억한다"
},
{
"s": 81.66,
"e": 82.54,
"text": "그 냄새를"
},
{
"s": 82.54,
"e": 83.56,
"text": "{그게 뭔데}?"
},
{
"s": 83.56,
"e": 86.9,
"text": "아~ {할머니 부엌을 가득 채웠었던}"
},
{
"s": 86.9,
"e": 88.76,
"text": "장소랑 시간도 똑같아"
},
{
"s": 88.76,
"e": 91.54,
"text": "질문하고 답변하면서 이해해야 돼"
},
{
"s": 91.54,
"e": 92.6,
"text": "우리는 드디어 찾았다"
},
{
"s": 92.6,
"e": 93.26,
"text": "식당을"
},
{
"s": 93.26,
"e": 94.3,
"text": "{어딘데}?"
},
{
"s": 94.3,
"e": 97.42,
"text": "아~ {국수가 진짜 맛있었던 곳}"
},
{
"s": 97.42,
"e": 99.7,
"text": "두 번째, 나는 여전히 기억한다"
},
{
"s": 99.7,
"e": 100.32,
"text": "그날을"
},
{
"s": 100.32,
"e": 101.46,
"text": "{언젠데}?"
},
{
"s": 101.46,
"e": 105.42,
"text": "아~ {병원에서 전화가 왔던 날}"
},
{
"s": 105.42,
"e": 106.48,
"text": "어때?"
},
{
"s": 106.48,
"e": 107.58,
"text": "한 번도 안 되돌아가도"
},
{
"s": 107.58,
"e": 110.68,
"text": "이해가 잘 되지?"
},
{
"s": 110.68,
"e": 112.16,
"text": "앞으로 이거 두 개만 기억하세요"
},
{
"s": 112.16,
"e": 115.2,
"text": "① 관계사가 보이면 {맞는 질문}하기"
},
{
"s": 115.2,
"e": 119.0,
"text": "② \"아~\" 하면서 {이해한 듯} 이어 해석"
},
{
"s": 119.0,
"e": 120.46,
"text": "이렇게 꾸준히 연습하면"
},
{
"s": 120.46,
"e": 122.22,
"text": "어떤 긴 문장이어도"
},
{
"s": 122.22,
"e": 124.88,
"text": "되돌아가지 않고 이해가 될 거예요"
},
{
"s": 124.88,
"e": 127.44,
"text": "다음엔 더 긴 기출 문장으로 설명하고"
},
{
"s": 127.44,
"e": 130.12,
"text": "다른 구문 해석 연습법도 가져올 테니까"
},
{
"s": 130.12,
"e": 131.6,
"text": "{누보쌤 팔로우} 해두세요!"
}
],
