{"total": 73.36666666666666, "lines": [{"s": 0.0, "e": 1.5, "text": "내신 벼락치기 하는"}, {"s": 1.5, "e": 2.42, "text": "학생들 {주목}!"}, {"s": 2.42, "e": 4.14, "text": "내신 영어 {100점} 만든 쌤이"}, {"s": 4.14, "e": 6.08, "text": "벼락치기 필승법 알려드릴게요"}, {"s": 6.08, "e": 7.72, "text": "일단 {첫 번째}는 무슨 일이"}, {"s": 7.72, "e": 8.7, "text": "있어도 {내용 숙지}를"}, {"s": 8.7, "e": 9.32, "text": "해내는 건데"}, {"s": 9.32, "e": 11.34, "text": "벼락치기 하는 친구들은 스스로"}, {"s": 11.34, "e": 12.78, "text": "해석을 뚫어내면 안 돼요"}, {"s": 12.78, "e": 14.68, "text": "그냥 {해석지} 끼고 시작하세요"}, {"s": 14.68, "e": 16.16, "text": "이렇게 {한글 해석}을 먼저 보고"}, {"s": 16.16, "e": 18.02, "text": "내용을 {요약} 정리하시고요"}, {"s": 18.02, "e": 18.92, "text": "그 다음 영어 지문을"}, {"s": 18.92, "e": 19.98, "text": "보는데 {한글 해석}"}, {"s": 19.98, "e": 20.96, "text": "읽을 때 중요하다고"}, {"s": 20.96, "e": 22.18, "text": "생각했던 거 있죠?"}, {"s": 22.18, "e": 23.06, "text": "그걸 영어 문장에도"}, {"s": 23.06, "e": 25.04, "text": "똑같이 {형광펜} 쳐줍니다"}, {"s": 25.04, "e": 25.96, "text": "이렇게 하면 추후"}, {"s": 25.96, "e": 26.9, "text": "우리가 직전 복습을"}, {"s": 26.9, "e": 28.18, "text": "할 때 효율적인"}, {"s": 28.18, "e": 29.12, "text": "공부가 가능합니다"}, {"s": 29.12, "e": 30.6, "text": "{두 번째}는 처음부터"}, {"s": 30.6, "e": 32.48, "text": "{변형 문제}로 공부하는 건데요"}, {"s": 32.48, "e": 33.2, "text": "EXAM4YOU나"}, {"s": 33.2, "e": 34.28, "text": "아잉카 같은 곳에서"}, {"s": 34.28, "e": 35.42, "text": "{변형 문제}를 구해서"}, {"s": 35.42, "e": 37.44, "text": "문제 풀지 마시고요"}, {"s": 37.44, "e": 38.72, "text": "그 문제에 나온 걸 내가"}, {"s": 38.72, "e": 40.36, "text": "공부하던 자료에 {표시}하세요"}, {"s": 40.36, "e": 41.78, "text": "예를 들어 여기 오른쪽에 있는"}, {"s": 41.78, "e": 43.02, "text": "{변형 문제}가 낱말 문제인데"}, {"s": 43.02, "e": 44.82, "text": "그 말은 여기 선택지에 있는"}, {"s": 44.82, "e": 45.92, "text": "단어들이 {중요 단어}라는"}, {"s": 45.92, "e": 46.92, "text": "뜻이겠죠?"}, {"s": 46.92, "e": 48.74, "text": "즉 중요한 것에 대한 판단을"}, {"s": 48.74, "e": 49.82, "text": "내가 아니라 자료가"}, {"s": 49.82, "e": 50.66, "text": "해주는 거죠"}, {"s": 50.66, "e": 51.72, "text": "자료는 {전문가}가 만드는"}, {"s": 51.72, "e": 53.4, "text": "거니 정확도가 높습니다"}, {"s": 53.4, "e": 54.54, "text": "특히 {정오답}으로 나왔던"}, {"s": 54.54, "e": 56.0, "text": "핵심 포인트는 {별표} 쳐주면"}, {"s": 56.0, "e": 57.36, "text": "아주 효율적으로 예상"}, {"s": 57.36, "e": 59.12, "text": "문제 공부할 수 있습니다"}, {"s": 59.12, "e": 60.72, "text": "세 번째는 {서술형} 공부인데요"}, {"s": 60.72, "e": 62.28, "text": "대다수 일반고는 단어 어법"}, {"s": 62.28, "e": 64.02, "text": "채우기 {영작}하기가 기본인데"}, {"s": 64.02, "e": 65.94, "text": "학교 선생님이 중요하다고 한"}, {"s": 65.94, "e": 67.06, "text": "단어, 문법이 담긴"}, {"s": 67.06, "e": 69.74, "text": "어구나 주제문을 암기하세요"}, {"s": 69.74, "e": 70.82, "text": "한 번에 외우는 건 힘드니까"}, {"s": 70.82, "e": 71.92, "text": "영문장을 {덩어리}로"}, {"s": 71.92, "e": 73.38, "text": "끊어서 암기하세요"}], "chips": [{"s": 6.08, "e": 29.02, "text": "STEP 1 내용 숙지"}, {"s": 29.12, "e": 59.019999999999996, "text": "STEP 2 변형 문제"}, {"s": 59.12, "e": 73.36666666666666, "text": "STEP 3 서술형"}], "cards": [{"s": 12.94, "e": 14.54, "label": "해석 혼자 X", "text": "{해석지} 끼고 시작"}, {"s": 16.6, "e": 18.2, "label": "STEP 1", "text": "{한글 해석} 먼저\n→ 요약"}, {"s": 23.68, "e": 25.28, "label": "STEP 1", "text": "영어에도\n{형광펜}"}, {"s": 36.54, "e": 38.14, "label": "STEP 2", "text": "풀지 말고\n{표시만}"}, {"s": 55.22, "e": 56.82, "label": "정답·오답 포인트", "text": "{별표} ★"}, {"s": 62.76, "e": 64.36, "label": "서술형 3종", "text": "단어 · 어법\n+ {영작}"}, {"s": 71.48, "e": 73.08, "label": "암기 요령", "text": "{덩어리}로 끊어서"}]}