{"total": 103.04, "lines": [{"s": 0.0, "e": 4.18, "text": "얘들아 중학 영어 A여도\n고등영어 {1등급} 안 나오는거 알아?"}, {"s": 4.18, "e": 5.08, "text": "쌤이 고등 때도"}, {"s": 5.08, "e": 6.64, "text": "{1등급} 받는 공부법"}, {"s": 6.64, "e": 7.76, "text": "딱 정리해줄 테니"}, {"s": 7.76, "e": 8.89, "text": "이대로만 해"}, {"s": 9.19, "e": 10.89, "text": "중학생 땐 교과서"}, {"s": 10.89, "e": 12.31, "text": "외우고 문제집 풀면 되지만"}, {"s": 12.31, "e": 14.03, "text": "고등학생은 시험범위가"}, {"s": 14.03, "e": 15.43, "text": "기본 {5배}야"}, {"s": 15.43, "e": 17.77, "text": "그래서 절대 {불가능}하거든"}, {"s": 17.77, "e": 18.77, "text": "그러니까 {겨울방학} 때"}, {"s": 18.77, "e": 21.32, "text": "이 {세 가지} 무조건 잡아두자"}, {"s": 21.62, "e": 23.04, "text": "첫째 문법"}, {"s": 23.04, "e": 24.52, "text": "고등 내신 문법은"}, {"s": 24.52, "e": 25.7, "text": "지문이 {변형돼서} 나와"}, {"s": 25.7, "e": 27.7, "text": "그래서 시험기간에 그때그때"}, {"s": 27.7, "e": 28.9, "text": "공부하면 무너져"}, {"s": 28.9, "e": 30.26, "text": "처음 보는 문장도"}, {"s": 30.26, "e": 31.02, "text": "{구조}를 따질 줄"}, {"s": 31.02, "e": 31.94, "text": "알아야 하기 때문에"}, {"s": 31.94, "e": 34.46, "text": "EBS {로즈리쌤} 그래머홀릭"}, {"s": 34.46, "e": 36.0, "text": "문법 끝판왕이니까"}, {"s": 36.0, "e": 37.98, "text": "이거 듣고 핵심 개념을"}, {"s": 37.98, "e": 39.38, "text": "강의 안 보고 {설명할} 수"}, {"s": 39.38, "e": 40.62, "text": "있을 때까지 {반복해}"}, {"s": 40.62, "e": 41.56, "text": "이것만 해도"}, {"s": 41.56, "e": 43.45, "text": "고등문법 {마스터}야"}, {"s": 43.75, "e": 45.01, "text": "둘째 해석"}, {"s": 45.01, "e": 45.87, "text": "해석이 {느리면} 시험"}, {"s": 45.87, "e": 46.89, "text": "공부도 너무 오래 걸리고"}, {"s": 46.89, "e": 48.57, "text": "시간 안에 문제도 다 못 풀어"}, {"s": 48.57, "e": 49.79, "text": "따라서 문장을 올바른"}, {"s": 49.79, "e": 50.55, "text": "위치에서 {끊고}"}, {"s": 50.55, "e": 52.05, "text": "그 끊은 {덩어리마다}"}, {"s": 52.05, "e": 54.45, "text": "{앞에서부터} 읽는 연습을 해야 해"}, {"s": 54.45, "e": 56.31, "text": "EBS {주혜연쌤} 해석 공식같은"}, {"s": 56.31, "e": 57.63, "text": "구문 강의로 패턴 익히고"}, {"s": 57.63, "e": 58.87, "text": "강의 없이 스스로"}, {"s": 58.87, "e": 61.05, "text": "해석되는지 꼭 {체크하자}"}, {"s": 61.05, "e": 62.23, "text": "또 쌤이 앞으로 꾸준히"}, {"s": 62.23, "e": 63.87, "text": "해석 연습법 {인스타랑}"}, {"s": 63.87, "e": 65.07, "text": "유튜브에 올릴 거니까"}, {"s": 65.07, "e": 66.34, "text": "그걸 봐도 좋아"}, {"s": 66.64, "e": 68.16, "text": "셋째, 단어"}, {"s": 68.16, "e": 69.0, "text": "같은 단어여도"}, {"s": 69.0, "e": 70.22, "text": "중학생 때 암기했던"}, {"s": 70.22, "e": 71.82, "text": "거랑 뜻이 다른 단어가 많아"}, {"s": 71.82, "e": 73.42, "text": "예를 들어, {address}"}, {"s": 73.42, "e": 74.04, "text": "주소 아니고"}, {"s": 74.04, "e": 75.76, "text": "{다루다}, 연설하다야"}, {"s": 75.76, "e": 77.2, "text": "고등 영단어장으로"}, {"s": 77.2, "e": 78.52, "text": "새로 외워야 하고"}, {"s": 78.52, "e": 79.16, "text": "또 내신에서"}, {"s": 79.16, "e": 80.5, "text": "본문 단어를 {유의어}로"}, {"s": 80.5, "e": 81.6, "text": "바꿔서 낼 수 있으니"}, {"s": 81.6, "e": 83.52, "text": "한글 뜻 하나만 일대일로"}, {"s": 83.52, "e": 85.72, "text": "외우지 말고 핵심 {뉘앙스}랑"}, {"s": 85.72, "e": 87.34, "text": "{유의어}까지 같이 챙겨"}, {"s": 87.34, "e": 89.0, "text": "그리고 여러 단어장 보지 말고"}, {"s": 89.0, "e": 91.24, "text": "{한 단어장만} 일 년 내내 해"}, {"s": 91.24, "e": 94.13, "text": "쌤은 영일만 {VOCA} 강추할게"}, {"s": 94.43, "e": 96.45, "text": "앞으로 내신 대비법부터"}, {"s": 96.45, "e": 98.25, "text": "수능 독해, 문풀 꿀팁까지"}, {"s": 98.25, "e": 99.77, "text": "누보쌤이 계속 올려줄 테니까"}, {"s": 99.77, "e": 100.69, "text": "고등영어 제대로"}, {"s": 100.69, "e": 102.74, "text": "준비하고 싶으면 쌤 {팔로우해!}"}], "heads": [{"s": 0, "head": "중학 영어 vs {고등} 영어"}, {"s": 9.19, "head": "중학 공부 vs {고등} 공부"}, {"s": 21.62, "step": "1", "head": ""}, {"s": 43.75, "step": "2", "head": ""}, {"s": 66.64, "step": "3", "head": ""}, {"s": 94.43, "head": "앞으로 올라올 {꿀팁}"}], "els": [{"s": 0.88, "e": 9.19, "k": "circle", "x": 290, "y": 720, "r": 170, "text": "중학\nA", "c": "red"}, {"s": 1.46, "e": 9.19, "k": "text", "x": 0, "y": 675, "text": "vs", "size": 80, "center": true}, {"s": 1.96, "e": 9.19, "k": "circle", "x": 790, "y": 720, "r": 170, "text": "고등\n?등급", "c": "blue"}, {"s": 2.86, "e": 9.19, "k": "text", "x": 820, "y": 470, "text": "ㅠㅠ", "size": 90, "color": "#2352E8"}, {"s": 5.08, "e": 9.19, "k": "text", "x": 0, "y": 1010, "text": "{1등급} 공부법 딱 정리!", "size": 80, "center": true}, {"s": 10.41, "e": 21.62, "k": "circle", "x": 290, "y": 700, "r": 170, "text": "교과서\n+ 문제집", "c": "red"}, {"s": 12.31, "e": 21.62, "k": "text", "x": 0, "y": 655, "text": "vs", "size": 80, "center": true}, {"s": 13.37, "e": 21.62, "k": "circle", "x": 790, "y": 700, "r": 170, "text": "시험 범위\nx5", "c": "blue"}, {"s": 16.49, "e": 21.62, "k": "tick", "x": 290, "y": 700, "size": 240, "type": "x"}, {"s": 18.03, "e": 21.62, "k": "text", "x": 0, "y": 980, "text": "{겨울방학}에 3가지 잡기", "size": 76, "center": true}, {"s": 19.19, "e": 21.62, "k": "text", "x": 0, "y": 1110, "text": "문법 · 해석 · 단어", "size": 64, "center": true, "color": "#2352E8"}, {"s": 24.92, "e": 28.9, "k": "text", "x": 0, "y": 560, "text": "내신 문법 = {지문 변형}", "size": 76, "center": true}, {"s": 28.9, "e": 43.75, "k": "card", "x": 70, "y": 430, "w": 940, "size": 46, "text": "The policy [that we approved] [will affect] residents.", "marks": [{"s": 30.26, "text": "", "label": "꾸밈 (관계절)", "c": "red"}, {"s": 30.64, "text": "", "label": "진짜 동사", "c": "blue"}]}, {"s": 32.9, "e": 43.75, "k": "img", "x": 120, "y": 780, "w": 300, "src": "book_grammarholic.jpg", "cap": "EBS 로즈리 Grammar Holic"}, {"s": 38.84, "e": 43.75, "k": "text", "x": 480, "y": 880, "text": "강의 없이\n{스스로 설명}할 수\n있을 때까지 반복", "size": 58}, {"s": 42.44, "e": 43.75, "k": "tick", "x": 930, "y": 830, "size": 120, "type": "check"}, {"s": 45.35, "e": 48.93, "k": "text", "x": 0, "y": 560, "text": "해석 느리면\n시간 {부족}", "size": 84, "center": true}, {"s": 48.93, "e": 61.05, "k": "card", "x": 70, "y": 430, "w": 940, "size": 46, "text": "[The policy] [that we approved] [will affect residents.]", "marks": [{"s": 50.19, "text": "", "label": "①", "c": "blue"}, {"s": 51.39, "text": "", "label": "②", "c": "red"}, {"s": 52.05, "text": "", "label": "③", "c": "blue"}]}, {"s": 54.75, "e": 61.05, "k": "img", "x": 120, "y": 780, "w": 300, "src": "book_haeseok.jpg", "cap": "EBS 주혜연 해석공식"}, {"s": 56.89, "e": 61.05, "k": "text", 