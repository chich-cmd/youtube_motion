{"total": 99.31, "lines": [{"s": 0.0, "e": 4.45, "text": "얘들아 중학 영어 A여도\n고등영어 {1등급} 안 나오는거 알아?"}, {"s": 4.45, "e": 7.11, "text": "중학생 땐 교과서 외우고 문제집 풀면 되지만"}, {"s": 7.11, "e": 9.45, "text": "고등학생은 시험범위가 기본 {5배}야"}, {"s": 9.45, "e": 11.18, "text": "그래서 정말 힘들거든"}, {"s": 11.48, "e": 13.44, "text": "하지만 쌤이 고등 때도"}, {"s": 13.44, "e": 14.74, "text": "{1등급} 받는 공부법"}, {"s": 14.74, "e": 16.16, "text": "딱 정리해줄 테니"}, {"s": 16.16, "e": 17.59, "text": "이대로만 해"}, {"s": 17.89, "e": 19.31, "text": "첫째 문법"}, {"s": 19.31, "e": 20.79, "text": "고등 내신 문법은"}, {"s": 20.79, "e": 21.97, "text": "지문이 {변형돼서} 나와"}, {"s": 21.97, "e": 23.97, "text": "그래서 시험기간에 그때그때"}, {"s": 23.97, "e": 25.17, "text": "공부하면 무너져"}, {"s": 25.17, "e": 26.53, "text": "처음 보는 문장도"}, {"s": 26.53, "e": 27.29, "text": "{구조}를 따질 줄"}, {"s": 27.29, "e": 28.21, "text": "알아야 하기 때문에"}, {"s": 28.21, "e": 30.73, "text": "EBS {로즈리쌤} 그래머홀릭"}, {"s": 30.73, "e": 32.27, "text": "문법 끝판왕이니까"}, {"s": 32.27, "e": 34.25, "text": "이거 듣고 핵심 개념을"}, {"s": 34.25, "e": 35.65, "text": "강의 안 보고 {설명할} 수"}, {"s": 35.65, "e": 36.89, "text": "있을 때까지 {반복해}"}, {"s": 36.89, "e": 37.83, "text": "이것만 해도"}, {"s": 37.83, "e": 39.72, "text": "고등문법 {마스터}야"}, {"s": 40.02, "e": 41.28, "text": "둘째 해석"}, {"s": 41.28, "e": 42.14, "text": "해석이 {느리면} 시험"}, {"s": 42.14, "e": 43.16, "text": "공부도 너무 오래 걸리고"}, {"s": 43.16, "e": 44.84, "text": "시간 안에 문제도 다 못 풀어"}, {"s": 44.84, "e": 46.06, "text": "따라서 문장을 올바른"}, {"s": 46.06, "e": 46.82, "text": "위치에서 {끊고}"}, {"s": 46.82, "e": 48.32, "text": "그 끊은 {덩어리마다}"}, {"s": 48.32, "e": 50.72, "text": "{앞에서부터} 읽는 연습을 해야 해"}, {"s": 50.72, "e": 52.58, "text": "EBS {주혜연쌤} 해석 공식같은"}, {"s": 52.58, "e": 53.9, "text": "구문 강의로 패턴 익히고"}, {"s": 53.9, "e": 55.14, "text": "강의 없이 스스로"}, {"s": 55.14, "e": 57.32, "text": "해석되는지 꼭 {체크하자}"}, {"s": 57.32, "e": 58.5, "text": "또 쌤이 앞으로 꾸준히"}, {"s": 58.5, "e": 60.14, "text": "해석 연습법 {인스타랑}"}, {"s": 60.14, "e": 61.34, "text": "유튜브에 올릴 거니까"}, {"s": 61.34, "e": 62.61, "text": "그걸 봐도 좋아"}, {"s": 62.91, "e": 64.43, "text": "셋째, 단어"}, {"s": 64.43, "e": 65.27, "text": "같은 단어여도"}, {"s": 65.27, "e": 66.49, "text": "중학생 때 암기했던"}, {"s": 66.49, "e": 68.09, "text": "거랑 뜻이 다른 단어가 많아"}, {"s": 68.09, "e": 69.69, "text": "예를 들어, {address}"}, {"s": 69.69, "e": 70.31, "text": "주소 아니고"}, {"s": 70.31, "e": 72.03, "text": "{다루다}, 연설하다야"}, {"s": 72.03, "e": 73.47, "text": "고등 영단어장으로"}, {"s": 73.47, "e": 74.79, "text": "새로 외워야 하고"}, {"s": 74.79, "e": 75.43, "text": "또 내신에서"}, {"s": 75.43, "e": 76.77, "text": "본문 단어를 {유의어}로"}, {"s": 76.77, "e": 77.87, "text": "바꿔서 낼 수 있으니"}, {"s": 77.87, "e": 79.79, "text": "한글 뜻 하나만 일대일로"}, {"s": 79.79, "e": 81.99, "text": "외우지 말고 핵심 {뉘앙스}랑"}, {"s": 81.99, "e": 83.61, "text": "{유의어}까지 같이 챙겨"}, {"s": 83.61, "e": 85.27, "text": "그리고 여러 단어장 보지 말고"}, {"s": 85.27, "e": 87.51, "text": "{한 단어장만} 일 년 내내 해"}, {"s": 87.51, "e": 90.4, "text": "쌤은 영일만 {VOCA} 강추할게"}, {"s": 90.7, "e": 92.72, "text": "앞으로 내신 대비법부터"}, {"s": 92.72, "e": 94.52, "text": "수능 독해, 문풀 꿀팁까지"}, {"s": 94.52, "e": 96.04, "text": "누보쌤이 계속 올려줄 테니까"}, {"s": 96.04, "e": 96.96, "text": "고등영어 제대로"}, {"s": 96.96, "e": 99.01, "text": "준비하고 싶으면 쌤 {팔로우해!}"}], "heads": [{"s": 0, "head": "중학 영어 vs {고등} 영어"}, {"s": 4.45, "head": "중학 공부 vs {고등} 공부"}, {"s": 17.89, "step": "1", "head": ""}, {"s": 40.02, "step": "2", "head": ""}, {"s": 62.91, "step": "3", "head": ""}, {"s": 90.7, "head": "앞으로 올라올 {꿀팁}"}], "els": [{"s": 0.88, "e": 4.45, "k": "circle", "x": 290, "y": 720, "r": 170, "text": "중학\nA", "c": "red"}, {"s": 1.46, "e": 4.45, "k": "text", "x": 0, "y": 675, "text": "vs", "size": 80, "center": true}, {"s": 1.96, "e": 4.45, "k": "circle", "x": 790, "y": 720, "r": 170, "text": "고등\n?등급", "c": "blue"}, {"s": 2.86, "e": 4.45, "k": "text", "x": 820, "y": 470, "text": "ㅠㅠ", "size": 90, "color": "#2352E8"}, {"s": 5.47, "e": 11.48, "k": "circle", "x": 290, "y": 700, "r": 170, "text": "교과서\n+ 문제집", "c": "red"}, {"s": 7.11, "e": 11.48, "k": "text", "x": 0, "y": 655, "text": "vs", "size": 80, "center": true}, {"s": 7.85, "