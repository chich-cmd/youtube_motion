{"dur": 482.4416650000001, "lines": [{"s": 0.0, "e": 1.736, "text": "내신이 2주 정도밖에 안 남은"}, {"s": 1.736, "e": 2.934, "text": "정말 급한 친구들을 위해서"}, {"s": 2.934, "e": 5.213, "text": "지금 공부해도 {20점}은 충분히 올릴 수 있는"}, {"s": 5.213, "e": 7.513, "text": "내신 벼락치기 공부법을 준비했어요"}, {"s": 7.513, "e": 8.753, "text": "벼락치기를 하고 있는 친구들은"}, {"s": 8.753, "e": 10.053, "text": "아마 {내용 숙지}도 잘 안"}, {"s": 10.053, "e": 11.114, "text": "돼 있을 거라고 생각합니다"}, {"s": 11.114, "e": 12.485, "text": "그래서 선생님이 이제 {내용 숙지}"}, {"s": 12.485, "e": 13.987, "text": "그리고 더 효과적으로"}, {"s": 13.987, "e": 15.287, "text": "{어법}이랑 어휘 공부하는 법"}, {"s": 15.287, "e": 17.067, "text": "그리고 {영작} 대비하는 법 이렇게 세 가지를"}, {"s": 17.067, "e": 18.23, "text": "벼락치기를 어떻게 해야"}, {"s": 18.23, "e": 19.073, "text": "되는지를 알려드릴 테니까"}, {"s": 19.073, "e": 21.0, "text": "이 남은 2주를 제가 알려드리는 방법대로"}, {"s": 21.0, "e": 23.028, "text": "정말 전략적으로 공부를 해봅시다"}, {"s": 23.028, "e": 24.653, "text": "일단 {1순위}는요"}, {"s": 24.653, "e": 26.953, "text": "무슨 일이 있어도 {내용 숙지}를 해내는 건데"}, {"s": 26.953, "e": 28.473, "text": "벼락치기를 하는 친구들은"}, {"s": 28.473, "e": 29.913, "text": "절대 무슨 일이 있어도"}, {"s": 29.913, "e": 32.654, "text": "{스스로} 이 해석을 뚫어내려고 하지 마시고요"}, {"s": 32.654, "e": 35.52, "text": "무조건 이렇게 {해설지}를 끼고 시작을 하세요"}, {"s": 35.52, "e": 36.98, "text": "자 왼쪽에 영어 지문"}, {"s": 36.98, "e": 39.16, "text": "{오른쪽}에 해석이 있는 파일을"}, {"s": 39.16, "e": 41.96, "text": "{황영카} 같은 영어공부 카페를 찾아보면"}, {"s": 41.96, "e": 44.14, "text": "무료로 다 공유가 되어 있는데요"}, {"s": 44.14, "e": 45.38, "text": "저도 지금 이 파일 방금"}, {"s": 45.38, "e": 46.62, "text": "5분 검색해서 찾아낸 거예요"}, {"s": 46.62, "e": 47.78, "text": "그거를 찾아서 쓰세요"}, {"s": 47.78, "e": 49.38, "text": "파일을 찾아서 뭐 인쇄를 하거나"}, {"s": 49.38, "e": 51.18, "text": "저처럼 이렇게 다운을 받았다면"}, {"s": 51.18, "e": 52.932, "text": "우리가 해야 되는 첫 번째는 뭐냐"}, {"s": 52.932, "e": 54.613, "text": "바로 이 {오른쪽}에 있는"}, {"s": 54.613, "e": 56.453, "text": "{한글 해석}을 먼저 보고"}, {"s": 56.453, "e": 57.916, "text": "{요약} 정리하는 거예요"}, {"s": 57.916, "e": 59.84, "text": "영어 지문을 보기 전에 {한글 해석}을 보고"}, {"s": 59.84, "e": 62.005, "text": "내용을 이해하고 {요약} 정리까지 하는 겁니다"}, {"s": 62.005, "e": 62.867, "text": "한 문장마다"}, {"s": 62.867, "e": 63.907, "text": "이런 식으로 하는 거죠"}, {"s": 63.907, "e": 64.767, "text": "천천히 읽으세요 천천히"}, {"s": 64.767, "e": 65.567, "text": "팬인 자신에게"}, {"s": 65.567, "e": 66.907, "text": "그러니까 쉽게 말해서 팬인 나에게"}, {"s": 66.907, "e": 69.487, "text": "선수가 뭘 해줘야 하는지 생각하는데"}, {"s": 69.487, "e": 71.007, "text": "많은 시간을 보내는 성향이 있는 팬은"}, {"s": 71.007, "e": 71.687, "text": "그러니까 말이 되게 긴데"}, {"s": 71.687, "e": 72.647, "text": "결론은 뭐냐면"}, {"s": 72.647, "e": 75.134, "text": "팬인 나에게 뭘 해줘야 돼?"}, {"s": 75.134, "e": 75.876, "text": "이런 것들을 생각하는데"}, {"s": 75.876, "e": 76.839, "text": "시간을 많이 쓰는 팬은"}, {"s": 76.839, "e": 78.624, "text": "팬으로서 가지고 있는 상응하는 의무"}, {"s": 78.624, "e": 79.146, "text": "지금 무슨 소리 하면"}, {"s": 79.146, "e": 81.616, "text": "팬인 내가 선수에게 해줘야 하는 거"}, {"s": 81.616, "e": 83.681, "text": "그것에 대해서도 꼭 생각을 해야 한다"}, {"s": 83.681, "e": 84.302, "text": "라는 얘기죠"}, {"s": 84.302, "e": 86.306, "text": "이렇게 한국어를 읽고 정리를 하는 겁니다"}, {"s": 86.306, "e": 87.329, "text": "이게 첫 번째"}, {"s": 87.329, "e": 88.151, "text": "그리고 두 번째는"}, {"s": 88.151, "e": 91.039, "text": "이 왼쪽에 영어 지문을 쭉쭉 해석을 해보면서"}, {"s": 91.039, "e": 93.16, "text": "방금 읽은 {한글 해석}이랑"}, {"s": 93.16, "e": 95.046, "text": "내용을 떠올려 보는 겁니다"}, {"s": 95.046, "e": 97.201, "text": "그리고 {한글 해석}지 읽을 때"}, {"s": 97.201, "e": 98.546, "text": "중요하다고 생각했던 부분에"}, {"s": 98.546, "e": 100.273, "text": "{형광펜}을 쳐주는 거예요"}, {"s": 100.273, "e": 101.053, "text": "예시를 보여드리면"}, {"s": 101.053, "e": 102.393, "text": "이렇게 하는 거죠"}, {"s": 102.393, "e": 102.833, "text": "팬들은"}, {"s": 102.833, "e": 103.853, "text": "근데 누구야"}, {"s": 103.853, "e": 105.293, "text": "그런데 여러분 읽다가 보면 분명히"}, {"s": 105.293, "e": 105.914, "text": "이렇게"}, {"s": 105.914, "e": 107.316, "text": "어라? 이거 해석 어떻게 하는 거지?"}, {"s": 107.316, "e": 108.137, "text": "막히는 게 있을 거예요"}, {"s": 108.137, "e": 109.679, "text": "왜? 나는 지금 벼락치기를 하고 있는 거니까"}, {"s": 109.679, "e": 110.34, "text": "잘 모르잖아요"}, {"s": 110.34, "e": 111.682, "text": "그래서 어머 이게 뜻이 뭐지?"}, {"s": 111.682, "e": 112.423, "text": "하고 해석을 어떻게 하지?"}, {"s": 112.423, "e": 112.823, "text": "막히는 거는"}, {"s": 112.823, "e": 113.805, "text": "고민을 절대 하지 말고"}, {"s": 113.805, "e": 115.106, "text": "그냥 바로 {오른쪽}에 아까"}, {"s": 115.106, "e": 116.781, "text": "그 {한글 해석}을 보는 거예요"}, {"s": 116.781, "e": 117.684, "text": "그럼 여기 spend는 알잖아"}, {"s": 117.684, "e": 118.488, "text": "우리가 쓰다잖아"}, {"s": 118.488, "e": 119.612, "text": "많은 시간을 쓰다라고 돼 있으니까"}, {"s": 119.612, "e": 121.293, "text": "여기 많은 시간을 여기 있는데"}, {"s": 121.293, "e": 123.356, "text": "그러면 많은 시간을 보내는 성향이 있는"}, {"s": 123.356, "e": 124.117, "text": "팬은이라고 돼 있으니까"}, {"s": 124.117, "e": 124.838, "text": "여러분이"}, {"s": 124.838, "e": 126.239, "text": "이 are inclined to는"}, {"s": 126.239, "e": 127.36, "text": "성향이 있다"}, {"s": 127.36, "e": 128.46, "text": "이 정도로 해석을 하면 되겠구나라고"}, {"s": 128.46, "e": 129.74, "text": "알 수 있는 겁니다"}, {"s": 129.74, "e": 130.48, "text": "이해 되셨죠?"}, {"s": 130.48, "e": 131.36, "text": "그래서 해석이 막히면"}, {"s": 131.36, "e": 132.58, "text": "그냥 고민하지 말고 어떻게 해라?"}, {"s": 132.58, "e": 133.683, "text": "바로 {오른쪽}에 있는 거랑"}, {"s": 133.683, "e": 135.171, "text": "비교를 해서 해석을 해라"}, {"s": 135.171, "e": 135.496, "text": "하여튼"}, {"s": 135.496, "e": 136.84, "text": "그런 식으로 해석을 쭉 합니다"}, {"s": 136.84, "e": 137.38, "text": "그래서 팬들은"}, {"s": 137.38, "e": 138.44, "text": "성향이 있는데"}, {"s": 138.44, "e": 140.02, "text": "많은 시간을 써"}, {"s": 140.02, "e": 140.78, "text": "근데 뭐 하는데?"}, {"s": 140.78, "e": 141.26, "text": "생각하는데?"}, {"s": 141.26, "e": 142.24, "text": "근데 뭐에 대해서?"}, {"s": 142.24, "e": 143.36, "text": "그 운동선수들이"}, {"s": 143.36, "e": 145.26, "text": "그들에게 해줘야 하는 거에 대해서"}, {"s": 145.26, "e": 146.12, "text": "이런 것들도"}, {"s": 146.12, "e": 147.66, "text": "이 단어에 대해서 너무 집착하지 말고"}, {"s": 147.66, "e": 148.5, "text": "그냥 {오른쪽}에 있는 그"}, {"s": 148.5, "e": 149.74, "text": "해석이랑 비교를 하면서"}, {"s": 149.74, "e": 150.42, "text": "해석을 하는 거야"}, {"s": 150.42, "e": 151.06, "text": "그렇게 해서 이제 우리가"}, {"s": 151.06, "e": 152.22, "text": "해석을 뭐 이제 쭉 다 끝났으면"}, {"s": 152.22, "e": 152.989, "text": "그 다음에"}, {"s": 152.989, "e": 154.219, "text": "{한글 해석}지 읽을 때"}, {"s": 154.219, "e": 155.856, "text": "중요하다고 생각했던 부분 있죠?"}, {"s": 155.856, "e": 157.129, "text": "그거를 영어 문장에도"}, {"s": 157.129, "e": 157.87, "text": "똑같이"}, {"s": 157.87, "e": 159.172, "text": "{형광펜}을 쳐주는 겁니다"}, {"s": 159.172, "e": 159.974, "text": "이렇게요"}, {"s": 159.974, "e": 160.916, "text": "일단 생각하는데"}, {"s": 160.916, "e": 161.998, "text": "많은 시간을 쓰는데"}, {"s": 161.998, "e": 163.14, "text": "뭘 생각하는데?"}, {"s": 163.14, "e": 163.66, "text": "운동선수가"}, {"s": 163.66, "e": 164.9, "text": "그들에게 해줘야 되는 것에"}, {"s": 164.9, "e": 165.66, "text": "대하여"}, {"s": 165.66, "e": 167.12, "text": "이 부분이 제일 중요하겠죠?"}, {"s": 167.12, "e": 167.36, "text": "그쵸?"}, {"s": 167.36, "e": 168.64, "text": "그래서 운동선수가 그들에게"}, {"s": 168.64, "e": 169.76, "text": "해줘야 되는 게 뭔지에 대해서"}, {"s": 169.76, "e": 170.78, "text": "생각을 많이 하는 사람"}, {"s": 170.78, "e": 171.36, "text": "그 팬들은"}, {"s": 171.36, "e": 172.28, "text": "또 뭘 해야 된다?"}, {"s": 172.28, "e": 172.76, "text": "생각해야 되는데"}, {"s": 172.76, "e": 173.94, "text": "뭐에 대해서 생각해야 된다?"}, {"s": 173.94, "e": 174.66, "text": "상응하는 의무"}, {"s": 174.66, "e": 175.702, "text": "근데 그 의무 즉"}, {"s": 175.702, "e": 177.332, "text": "팬이 팬으로서 가지고 있는"}, {"s": 177.332, "e": 178.437, "text": "그러니까 내가"}, {"s": 178.437, "e": 179.119, "text": "{오른쪽}에"}, {"s": 179.119, "e": 180.14, "text": "{한글 해석}을"}, {"s": 180.14, "e": 181.22, "text": "보고 {요약}했던 내용이"}, {"s": 181.22, "e": 181.86, "text": "팬인 나에게"}, {"s": 181.86, "e": 183.66, "text": "선수가 뭘 해줘야 되느냐를"}, {"s": 183.66, "e": 184.58, "text": "생각하는 팬들은"}, {"s": 184.58, "e": 185.52, "text": "반대로 팬인 내가"}, {"s": 185.52, "e": 186.64, "text": "선수에게 뭘 해줘야 되는지도"}, {"s": 186.64, "e": 187.4, "text": "생각해야 된다라고"}, {"s": 187.4, "e": 188.0, "text": "{요약} 정리를 했는데"}, {"s": 188.0, "e": 189.24, "text": "영어 문장의 같은 부분에"}, {"s": 189.24, "e": 190.32, "text": "{형광펜}을 치는 거죠"}, {"s": 190.32, "e": 191.12, "text": "그리고 이 과정을"}, {"s": 191.12, "e": 192.46, "text": "나머지 문장들도"}, {"s": 192.46, "e": 193.5, "text": "그리고 시험범위에 해당하는"}, {"s": 193.5, "e": 194.4, "text": "모든 지문에"}, {"s": 194.4, "e": 195.62, "text": "똑같이 해주는 겁니다"}, {"s": 195.62, "e": 195.98, "text": "이렇게 하면"}, {"s": 195.98, "e": 197.18, "text": "추후에 우리가"}, {"s": 197.18, "e": 198.24, "text": "시험 전날이나 이런"}, {"s": 198.24, "e": 199.28, "text": "직전 복습을 할 때"}, {"s": 199.28, "e": 200.76, "text": "내가 {형광펜}을 친"}, {"s": 200.76, "e": 201.44, "text": "부분만"}, {"s": 201.44, "e": 202.221, "text": "중심으로 보거나"}, {"s": 202.221, "e": 203.242, "text": "아니면 한글 {요약}을 한"}, {"s": 203.242, "e": 203.603, "text": "것만"}, {"s": 203.603, "e": 204.664, "text": "중심으로 보면 되기 때문에"}, {"s": 204.664, "e": 205.525, "text": "아주 효율적으로"}, {"s": 205.525, "e": 206.386, "text": "빠르게 공부할 수 있어요"}, {"s": 206.386, "e": 206.886, "text": "그리고 혹시"}, {"s": 206.886, "e": 208.007, "text": "선생님 저는 이 한글"}, {"s": 208.007, "e": 208.747, "text": "문장을 봤는데"}, {"s": 208.747, "e": 210.067, "text": "국어실력이 조금 안 좋아서"}, {"s": 210.067, "e": 211.187, "text": "{요약}이 잘 안됩니다"}, {"s": 211.187, "e": 212.227, "text": "뭐 이런 학생들은"}, {"s": 212.227, "e": 212.607, "text": "뭐 또 이제"}, {"s": 212.607, "e": 213.307, "text": "글이 어려울 수도 있잖아요"}, {"s": 213.307, "e": 213.927, "text": "이거는 이제 글이 쉬운데"}, {"s": 213.927, "e": 214.547, "text": "글이 되게 어려우면"}, {"s": 214.547, "e": 215.627, "text": "내가 이해가 안 될 수도 있잖아요"}, {"s": 215.627, "e": 216.087, "text": "그런 경우에는"}, {"s": 216.087, "e": 217.167, "text": "{챗GPT}를 써"}, {"s": 217.167, "e": 217.71, "text": "그러니까 {챗GPT}에"}, {"s": 217.71, "e": 218.433, "text": "이 지문을"}, {"s": 218.433, "e": 219.818, "text": "그냥 복사해서 넣는 거야"}, {"s": 219.818, "e": 220.942, "text": "어차피 이거 인터넷 다운받은 파일이니까"}, {"s": 220.942, "e": 222.288, "text": "복사할 수 있잖아요"}, {"s": 222.288, "e": 223.039, "text": "그래서 그냥 이렇게"}, {"s": 224.433, "e": 225.193, "text": "명령을 하는 거예요"}, {"s": 225.193, "e": 226.553, "text": "이 문장을 한국어로 {요약}해주고"}, {"s": 226.553, "e": 227.453, "text": "{요약}에 해당하는"}, {"s": 227.453, "e": 228.293, "text": "중요한 영어 어구를"}, {"s": 228.293, "e": 229.473, "text": "해당 문장에서만"}, {"s": 229.473, "e": 229.973, "text": "집어줘"}, {"s": 229.973, "e": 230.813, "text": "이렇게 명령을 하면"}, {"s": 230.813, "e": 232.46, "text": "이 친구가 아주 똑똑하잖아요"}, {"s": 232.46, "e": 233.34, "text": "너무 깔끔하고"}, {"s": 233.34, "e": 234.242, "text": "예쁘게"}, {"s": 234.242, "e": 235.044, "text": "핵심만 딱"}, {"s": 235.044, "e": 236.327, "text": "떼서 적어줍니다"}, {"s": 236.327, "e": 237.607, "text": "선수에게 기대하는 팬이라면"}, {"s": 237.607, "e": 238.487, "text": "팬으로서 자신이"}, {"s": 238.487, "e": 239.187, "text": "어떤 책임을"}, {"s": 239.187, "e": 240.087, "text": "즉 어떤 의무를 져야 하는지도"}, {"s": 240.087, "e": 240.927, "text": "생각해봐야 한다"}, {"s": 240.927, "e": 241.647, "text": "내가 해야 할 생각을"}, {"s": 241.647, "e": 242.907, "text": "이제 이 친구가 대신해주는 거죠"}, {"s": 242.907, "e": 243.207, "text": "웬만하면"}, {"s": 243.207, "e": 244.147, "text": "본인이 생각하는 게 좋지만"}, {"s": 244.147, "e": 246.067, "text": "급하면 이렇게 {챗GPT}를 쓰셔도 됩니다"}, {"s": 246.067, "e": 246.287, "text": "그리고 또"}, {"s": 246.287, "e": 247.047, "text": "{요약}에 해당하는"}, {"s": 247.047, "e": 247.747, "text": "중요한 영어 어구도"}, {"s": 247.747, "e": 251.687, "text": "정확하게 이 문장에서만"}, {"s": 251.687, "e": 252.727, "text": "딱 집어줬죠"}, {"s": 252.727, "e": 253.107, "text": "그러니까 내가"}, {"s": 253.107, "e": 253.987, "text": "영어 문장에서"}, {"s": 253.987, "e": 255.887, "text": "여기에만 {형광펜}을 치면 되겠죠"}, {"s": 255.887, "e": 256.207, "text": "그래서"}, {"s": 256.207, "e": 257.127, "text": "여러분이"}, {"s": 257.127, "e": 257.907, "text": "이 과정을"}, {"s": 257.907, "e": 259.167, "text": "시험 범위 전 지문에 해주면"}, {"s": 259.167, "e": 260.227, "text": "내용 이해도 다 한 거고"}, {"s": 260.227, "e": 261.187, "text": "또 시험 전날에"}, {"s": 261.187, "e": 262.547, "text": "내가 {요약}한 것만 보면 되니까"}, {"s": 262.547, "e": 263.487, "text": "정말 빠르게"}, {"s": 263.487, "e": 264.592, "text": "공부할 수 있습니다"}, {"s": 264.592, "e": 264.907, "text": "그리고"}, {"s": 264.907, "e": 266.047, "text": "이 과정만 잘 하면"}, {"s": 266.047, "e": 266.967, "text": "여러분이 주제나"}, {"s": 266.967, "e": 267.687, "text": "순서나"}, {"s": 267.687, "e": 268.631, "text": "문장 삽입 같은"}, {"s": 268.631, "e": 269.736, "text": "기본 {변형 문제}는"}, {"s": 269.736, "e": 270.66, "text": "다 풀 수 있고요"}, {"s": 270.66, "e": 271.101, "text": "빈칸도"}, {"s": 271.101, "e": 271.682, "text": "선생님이"}, {"s": 271.682, "e": 272.744, "text": "문장 변형 안 하고"}, {"s": 272.744, "e": 273.465, "text": "그대로 되면"}, {"s": 273.465, "e": 274.467, "text": "쉽게 풀 수 있어요"}, {"s": 274.467, "e": 274.849, "text": "{2단계}"}, {"s": 274.849, "e": 275.532, "text": "처음부터"}, {"s": 275.532, "e": 276.513, "text": "{변형 문제}로"}, {"s": 276.513, "e": 277.433, "text": "공부하는 겁니다"}, {"s": 277.433, "e": 277.873, "text": "예를 들면"}, {"s": 277.873, "e": 278.513, "text": "{EXAM4YOU}나"}, {"s": 278.513, "e": 279.373, "text": "{아잉카} 같은 곳에서"}, {"s": 279.373, "e": 281.053, "text": "{변형 문제}를 구할 수 있는 친구들은"}, {"s": 281.053, "e": 282.233, "text": "{변형 문제}를 다운받습니다"}, {"s": 282.233, "e": 283.339, "text": "그리고 문제를 풀지"}, {"s": 283.339, "e": 284.242, "text": "마시고요"}, {"s": 284.242, "e": 285.064, "text": "풀 시간이 없죠"}, {"s": 285.064, "e": 286.228, "text": "이 문제에 나온 걸"}, {"s": 286.228, "e": 288.033, "text": "내가 공부하던 자료에"}, {"s": 288.033, "e": 288.993, "text": "{표시}할 겁니다"}, {"s": 288.993, "e": 289.433, "text": "예를 들면"}, {"s": 289.433, "e": 290.293, "text": "여기 {오른쪽}에 있는"}, {"s": 290.293, "e": 290.833, "text": "{변형 문제}가"}, {"s": 290.833, "e": 291.633, "text": "낱말 문제인데"}, {"s": 291.633, "e": 292.253, "text": "그 말은"}, {"s": 292.253, "e": 293.253, "text": "여기 선택지에 있는"}, {"s": 293.253, "e": 293.893, "text": "이 단어들이"}, {"s": 293.893, "e": 294.773, "text": "이 지문에서"}, {"s": 294.773, "e": 295.973, "text": "{중요 단어}라는 뜻 아니겠어요?"}, {"s": 295.973, "e": 296.575, "text": "그렇죠?"}, {"s": 296.575, "e": 297.318, "text": "그러니까 {중요 단어}를"}, {"s": 297.318, "e": 298.022, "text": "내가 판단하는 게 아니라"}, {"s": 298.022, "e": 299.087, "text": "이 문제가 해준 거잖아요"}, {"s": 299.087, "e": 299.71, "text": "그럼 그 고맙게"}, {"s": 299.71, "e": 300.755, "text": "받아 먹자는 거죠"}, {"s": 300.755, "e": 301.157, "text": "그리고 내가"}, {"s": 301.157, "e": 301.74, "text": "이 왼쪽에"}, {"s": 301.74, "e": 302.806, "text": "내가 이제 공부하던 자료에"}, {"s": 302.806, "e": 304.254, "text": "이 오른쪽 {변형 문제}에 있던 단어들을"}, {"s": 304.254, "e": 305.55, "text": "그대로 {표시}를 해주는 거죠"}, {"s": 306.657, "e": 308.122, "text": "이렇게 {표시}를 해줍니다"}, {"s": 308.122, "e": 308.502, "text": "그리고 여기 이제"}, {"s": 308.502, "e": 308.782, "text": "unstable"}, {"s": 308.782, "e": 310.322, "text": "그 다음에 답이 4번이다 보니까"}, {"s": 310.322, "e": 311.202, "text": "4번에 있는"}, {"s": 311.202, "e": 312.122, "text": "진짜 단어는"}, {"s": 312.122, "e": 312.822, "text": "여기 stable인데"}, {"s": 312.822, "e": 313.442, "text": "그럼 이렇게"}, {"s": 313.442, "e": 314.982, "text": "특히 {정오답}으로 나왔던"}, {"s": 314.982, "e": 316.502, "text": "이런 더 핵심적인 포인트는"}, {"s": 316.502, "e": 317.465, "text": "또 따로 이렇게 뭐"}, {"s": 317.465, "e": 317.987, "text": "괄호를"}, {"s": 317.987, "e": 318.91, "text": "꺽쇠를 쳐준다거나"}, {"s": 318.91, "e": 319.954, "text": "{별표}를 달아준다던가 해서"}, {"s": 319.954, "e": 321.495, "text": "조금 더 눈에 띄게 {표시}를 해주고"}, {"s": 321.495, "e": 321.975, "text": "그리고"}, {"s": 321.975, "e": 323.038, "text": "문제가"}, {"s": 323.038, "e": 324.002, "text": "fluctuating으로 나왔으니까"}, {"s": 324.002, "e": 324.886, "text": "여기 stable을"}, {"s": 324.886, "e": 325.348, "text": "만약에"}, {"s": 325.348, "e": 326.77, "text": "변동하다라는 맥락이 나오면"}, {"s": 326.77, "e": 327.13, "text": "안 된다"}, {"s": 327.13, "e": 327.871, "text": "뭐 이런 식으로 이제 또 {표시}를"}, {"s": 327.871, "e": 328.331, "text": "해주는 거죠"}, {"s": 328.331, "e": 329.653, "text": "기본적으로 {변형 문제} 자체가"}, {"s": 329.653, "e": 330.714, "text": "영어 강사님들이"}, {"s": 330.714, "e": 331.735, "text": "그것도 이 {변형 문제}를"}, {"s": 331.735, "e": 332.976, "text": "막 십수년씩 만들어 오시던"}, {"s": 332.976, "e": 333.617, "text": "강사님들이"}, {"s": 333.617, "e": 334.918, "text": "시험으로 나올 만한 부분을"}, {"s": 334.918, "e": 335.639, "text": "캐치를 해서"}, {"s": 335.639, "e": 336.3, "text": "내는 거다 보니까"}, {"s": 336.3, "e": 337.321, "text": "이 부분을 중심으로"}, {"s": 337.321, "e": 337.981, "text": "공부를 하면"}, {"s": 337.981, "e": 339.184, "text": "뭐가 중요한지에 대한"}, {"s": 339.184, "e": 340.588, "text": "정확도도 훨씬 올라가고"}, {"s": 340.588, "e": 341.988, "text": "속도도 빨라지겠죠"}, {"s": 341.988, "e": 342.328, "text": "솔직히"}, {"s": 342.328, "e": 343.748, "text": "벼락치기를 한다는 거는"}, {"s": 343.748, "e": 345.368, "text": "영어 공부를 제대로 안 해봤다는 건데"}, {"s": 345.368, "e": 346.988, "text": "그러면은 영어 공부를 제대로 안 해본 친구가"}, {"s": 346.988, "e": 348.228, "text": "이 생판 처음 보는 지문을 보고"}, {"s": 348.228, "e": 350.068, "text": "중요한 걸 어떻게 판단을 하겠어요"}, {"s": 350.068, "e": 350.288, "text": "그러니까"}, {"s": 350.288, "e": 351.628, "text": "처음부터 {전문가}한테"}, {"s": 351.628, "e": 352.768, "text": "맡긴다는 뜻이죠"}, {"s": 352.768, "e": 353.008, "text": "이게"}, {"s": 353.008, "e": 354.248, "text": "진짜 벼락치기에"}, {"s": 354.248, "e": 355.268, "text": "정말 효과적이고"}, {"s": 355.268, "e": 356.348, "text": "특히 {어법} 어휘"}, {"s": 356.348, "e": 357.609, "text": "제일 어렵잖아요"}, {"s": 357.609, "e": 358.234, "text": "{어법} 어휘에"}, {"s": 358.234, "e": 359.279, "text": "아주 효과가 있어요"}, {"s": 359.279, "e": 359.881, "text": "마지막 {세 번째}"}, {"s": 359.881, "e": 361.828, "text": "{서술형} 공부인데요"}, {"s": 361.828, "e": 362.228, "text": "{서술형}은"}, {"s": 362.228, "e": 363.388, "text": "대다수 일반고들은"}, {"s": 363.388, "e": 364.068, "text": "{단어 채우기}"}, {"s": 364.068, "e": 365.268, "text": "{어법 채우기}"}, {"s": 365.268, "e": 366.568, "text": "그리고 {영작}하기"}, {"s": 366.568, "e": 367.428, "text": "이 세 가지가"}, {"s": 367.428, "e": 369.03, "text": "기본이라고 생각하시면 됩니다"}, {"s": 369.03, "e": 370.48, "text": "즉 여러분이 공부하셔야 하는 것은"}, {"s": 370.48, "e": 372.022, "text": "학교 선생님이"}, {"s": 372.022, "e": 372.702, "text": "중요하다고 했던"}, {"s": 372.702, "e": 373.482, "text": "단어"}, {"s": 373.482, "e": 374.202, "text": "중요하다고 했던"}, {"s": 374.202, "e": 374.802, "text": "문법"}, {"s": 374.802, "e": 376.273, "text": "이 담긴 어구"}, {"s": 376.273, "e": 376.939, "text": "또는"}, {"s": 376.939, "e": 377.862, "text": "그 지문의"}, {"s": 377.862, "e": 379.268, "text": "주제문을 중심으로"}, {"s": 379.268, "e": 380.795, "text": "암기하시면 됩니다"}, {"s": 380.795, "e": 381.095, "text": "다만"}, {"s": 381.095, "e": 381.995, "text": "저희가 어떤 문장이나"}, {"s": 381.995, "e": 383.095, "text": "어구를 암기할 때"}, {"s": 383.095, "e": 383.855, "text": "예를 들어"}, {"s": 383.855, "e": 384.475, "text": "외운다고 쳤을 때"}, {"s": 384.475, "e": 385.715, "text": "이걸 한 번에 외우면"}, {"s": 385.715, "e": 386.455, "text": "당연히 힘들어"}, {"s": 386.455, "e": 387.355, "text": "그러니까 이 영어 문장을"}, {"s": 387.355, "e": 388.695, "text": "내가 외우기 좋게"}, {"s": 388.695, "e": 389.595, "text": "즉 기억하기 좋게"}, {"s": 389.595, "e": 390.155, "text": "{끊어}두고"}, {"s": 390.155, "e": 391.015, "text": "{덩어리}화"}, {"s": 391.015, "e": 392.235, "text": "하여 외워야 합니다"}, {"s": 392.235, "e": 393.217, "text": "저희 이전 영상에 나왔던"}, {"s": 393.217, "e": 393.899, "text": "{끊어} 읽기 전략이"}, {"s": 393.899, "e": 394.7, "text": "이렇게 내신 공부할 때도"}, {"s": 394.7, "e": 395.482, "text": "쓰이는 거죠"}, {"s": 395.482, "e": 395.702, "text": "예를 들어"}, {"s": 395.702, "e": 396.224, "text": "1번에"}, {"s": 396.224, "e": 396.825, "text": "저 making부터"}, {"s": 396.825, "e": 397.346, "text": "brain까지"}, {"s": 397.346, "e": 398.108, "text": "외운다고 치면"}, {"s": 398.108, "e": 399.676, "text": "우리를 만든다"}, {"s": 399.676, "e": 400.52, "text": "여기서 한 번 {끊어}주고"}, {"s": 400.52, "e": 401.565, "text": "심지어 더"}, {"s": 401.565, "e": 402.329, "text": "가능성 있게"}, {"s": 402.329, "e": 403.594, "text": "여기서 한 번 {끊어}주고"}, {"s": 403.594, "e": 404.216, "text": "그리고"}, {"s": 404.216, "e": 405.158, "text": "피로한 뇌를"}, {"s": 405.158, "e": 405.72, "text": "경험할"}, {"s": 405.72, "e": 406.842, "text": "이렇게 {끊어}줘서"}, {"s": 406.842, "e": 407.885, "text": "세 {덩어리}로 만드시면"}, {"s": 407.885, "e": 409.448, "text": "외우기가 쉽겠죠?"}, {"s": 409.448, "e": 410.068, "text": "왜냐하면 making부터"}, {"s": 410.068, "e": 410.768, "text": "brain까지 한 번에"}, {"s": 410.768, "e": 411.288, "text": "외운다는 거는"}, {"s": 411.288, "e": 412.168, "text": "되게 머리가 아픈데"}, {"s": 412.168, "e": 413.248, "text": "making us 외우기 쉽고"}, {"s": 413.248, "e": 414.3, "text": "even more likely"}, {"s": 415.62, "e": 416.541, "text": "내가 외우고 싶은 문장을"}, {"s": 416.541, "e": 417.728, "text": "외울 수 있습니다"}, {"s": 417.728, "e": 418.208, "text": "그리고 외울 때"}, {"s": 418.208, "e": 418.868, "text": "한국어도"}, {"s": 418.868, "e": 420.768, "text": "이렇게 {끊어}서 적어두시면 좋아요"}, {"s": 420.768, "e": 421.688, "text": "우리를 만들면서"}, {"s": 421.688, "e": 422.718, "text": "심지어 더"}, {"s": 422.718, "e": 423.562, "text": "가능성 있게"}, {"s": 423.562, "e": 424.602, "text": "피로한 뇌를"}, {"s": 424.602, "e": 425.307, "text": "할"}, {"s": 425.307, "e": 426.199, "text": "이런 식으로"}, {"s": 426.199, "e": 426.842, "text": "그래서"}, {"s": 426.842, "e": 428.742, "text": "이렇게 {매칭}을 시켜서"}, {"s": 428.742, "e": 429.122, "text": "기억하면"}, {"s": 429.122, "e": 430.093, "text": "더 빠르게"}, {"s": 430.093, "e": 431.315, "text": "외우실 수 있습니다"}, {"s": 431.315, "e": 431.555, "text": "그래서 이렇게"}, {"s": 431.555, "e": 432.975, "text": "내신 벼락치기 공부법에 대해서"}, {"s": 432.975, "e": 433.735, "text": "설명을 드려봤는데"}, {"s": 433.735, "e": 434.335, "text": "다시 한 번"}, {"s": 434.335, "e": 435.458, "text": "오늘 배운 내용을"}, {"s": 435.458, "e": 436.619, "text": "상기시켜봅시다"}, {"s": 436.619, "e": 437.742, "text": "1단계 뭐였죠?"}, {"s": 437.742, "e": 438.522, "text": "{내용 숙지}"}, {"s": 438.522, "e": 440.042, "text": "{내용 숙지}할 때 어떻게 한다?"}, {"s": 440.042, "e": 440.222, "text": "우리"}, {"s": 440.222, "e": 441.662, "text": "이렇게 교차해가면서"}, {"s": 441.662, "e": 442.682, "text": "공부를 하는 거예요"}, {"s": 442.682, "e": 443.522, "text": "제 첫 번째 영상에"}, {"s": 443.522, "e": 444.182, "text": "교차해석법이랑"}, {"s": 444.182, "e": 445.222, "text": "되게 비슷해요"}, {"s": 445.222, "e": 446.125, "text": "근본적인 영어 공부는"}, {"s": 446.125, "e": 447.088, "text": "다 비슷하다는 거"}, {"s": 447.088, "e": 447.608, "text": "그리고 이제 두 번째"}, {"s": 447.608, "e": 449.014, "text": "{변형 문제}를 통해서"}, {"s": 449.014, "e": 450.542, "text": "중요한 것만 공부하자"}, {"s": 450.542, "e": 452.035, "text": "그래서 {변형 문제} 써먹기"}, {"s": 452.035, "e": 453.782, "text": "꼭 유료 자료 아니어도 돼요"}, {"s": 453.782, "e": 453.942, "text": "하나"}, {"s": 453.942, "e": 455.345, "text": "이런 데 잘 찾아보면"}, {"s": 455.345, "e": 456.466, "text": "무료로 {변형 문제}도"}, {"s": 456.466, "e": 457.228, "text": "은근 많이 올라와 있으니까"}, {"s": 457.228, "e": 459.088, "text": "그런 거 활용하셔도 좋습니다"}, {"s": 459.088, "e": 459.508, "text": "{세 번째}"}, {"s": 459.508, "e": 460.708, "text": "{서술형} 공부"}, {"s": 460.708, "e": 462.268, "text": "{서술형} 공부는 어떻게 한다?"}, {"s": 462.268, "e": 462.828, "text": "당연하지만"}, {"s": 462.828, "e": 464.588, "text": "학교 선생님이 강조했던 거"}, {"s": 464.588, "e": 466.348, "text": "즉 선생님이 강조했던 거를"}, {"s": 466.348, "e": 467.448, "text": "중심으로 해서 외우고"}, {"s": 467.448, "e": 469.075, "text": "특히 문장 암기할 때는"}, {"s": 469.075, "e": 470.1, "text": "한 번에 암기하려고 하지 말고"}, {"s": 470.1, "e": 471.742, "text": "문장 {덩어리}화 해서"}, {"s": 471.742, "e": 472.362, "text": "외운다"}, {"s": 472.362, "e": 474.322, "text": "이렇게 하면 제법 성공적인"}, {"s": 474.322, "e": 474.902, "text": "벼락치기"}, {"s": 474.902, "e": 476.562, "text": "내신 공부를 끝내실 수 있을 겁니다"}, {"s": 476.562, "e": 477.242, "text": "영어 내신이 또"}, {"s": 477.242, "e": 478.342, "text": "되게 중요하잖아요"}, {"s": 478.342, "e": 479.042, "text": "그러니까 포기하지 말고"}, {"s": 479.042, "e": 480.542, "text": "힘내서 잘 해봅시다"}, {"s": 480.542, "e": 481.322, "text": "누보쌤과 함께하는"}, {"s": 481.322, "e": 482.442, "text": "노베탈출 파이팅!"}], "states": [{"s": 0.0, "step": 0, "sub": 0, "recap": 0}, {"s": 22.927, "step": 1, "sub": 0, "recap": 0}, {"s": 87.309, "step": 1, "sub": 1, "recap": 0}, {"s": 150.46, "step": 1, "sub": 2, "recap": 0}, {"s": 206.366, "step": 1, "sub": 3, "recap": 0}, {"s": 274.467, "step": 2, "sub": 0, "recap": 0}, {"s": 282.274, "step": 2, "sub": 1, "recap": 0}, {"s": 308.102, "step": 2, "sub": 2, "recap": 0}, {"s": 359.299, "step": 3, "sub": 0, "recap": 0}, {"s": 369.01, "step": 3, "sub": 1, "recap": 0}, {"s": 380.755, "step": 3, "sub": 2, "recap": 0}, {"s": 431.355, "step": 4, "sub": 0, "recap": 0}, {"s": 436.628, "step": 4, "sub": 0, "recap": 1}, {"s": 447.128, "step": 4, "sub": 0, "recap": 2}, {"s": 459.128, "step": 4, "sub": 0, "recap": 3}, {"s": 472.382, "step": 4, "sub": 0, "recap": 0}], "chapters": [{"