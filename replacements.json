[
 {
  "id": "r0",
  "start": 0.8,
  "end": 4.8,
  "text": "수능 40일 남았는데 영어로 최저 맞춰야 하는 친구들은 꼭 보세요.",
  "file": "rec/in1.m4a"
 },
 {
  "id": "r1",
  "start": 475.7,
  "end": 478.96,
  "text": "40일 남았으니까 40일 버전으로 조금 새로 알려드리면",
  "file": "rec/in10.m4a",
  "pre": 0.55
 },
 {
  "id": "r2",
  "start": 483.5,
  "end": 490.74,
  "text": "무조건 나 40일 동안 5회독한다. 즉 8일에 1회독씩 한다라고 생각하고 계획을 짜보세요.",
  "file": "rec/in2.m4a"
 },
 {
  "id": "r3",
  "start": 498.1,
  "end": 499.58,
  "text": "하루에 250개씩 외우면 되겠네",
  "file": "rec/in9.m4a"
 },
 {
  "id": "r4",
  "start": 504.5,
  "end": 516.8,
  "text": "1일차에 250번까지 암기, 2일차에 1에서 500번 암기, 복습하는 김에 3일차에는 1에서 750번, 이런 식으로요.",
  "file": "rec/in4.m4a"
 },
 {
  "id": "r5",
  "start": 516.8,
  "end": 520.96,
  "text": "그래서 8일차가 되면 내가 1에서 2000번을 한번 다 볼 수 있게",
  "file": "rec/in5.m4a"
 },
 {
  "id": "r6",
  "start": 557.4,
  "end": 560.68,
  "text": "그리고 1일차부터 8일차까지",
  "file": "rec/in6.m4a"
 },
 {
  "id": "r7",
  "start": 582.2,
  "end": 584.62,
  "text": "그리고 9일차가 되면",
  "file": "rec/in7.m4a"
 },
 {
  "id": "r8",
  "start": 593.1,
  "end": 595.64,
  "text": "이렇게 하면 17일차부터는",
  "file": "rec/in8.m4a"
 }
]